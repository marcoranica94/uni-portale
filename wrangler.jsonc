{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uni-portale",
  "account_id": "24c34273b949d8648adc8ae4ec697b69",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Il sito si serve solo da uni.marcoranica.com, protetto da Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  // Cloudflare Access: il Worker verifica anche lui il token (difesa in profondità). Valori pubblici, non segreti.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://narraya.cloudflareaccess.com",
    "ACCESS_SERVICE_CLIENT_ID": "41a6384a1cfcda4c4c264cb33329136b.access",
    "ACCESS_AUD": "ceb75856ea68b69c34ce29ad99bc489e791f68b2ba095503a7477e58157ccb0c"
  },
  "routes": [{ "pattern": "uni.marcoranica.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uni-portale",
      "database_id": "ad0d3cfe-a6f0-48b8-9a30-556d3db0fbb5",
      "migrations_dir": "migrations"
    }
  ]
}
