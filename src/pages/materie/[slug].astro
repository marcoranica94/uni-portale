---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import TipoEsame from '../../components/TipoEsame.astro';
import { getMaterie } from '../../lib/percorso';
import { getVoti, statoMateria, votoTesto } from '../../lib/voti';
import { getKit, ultimoLavoro, statoAgenti } from '../../lib/coda';
import { contaBanca, storico, FORMATI, ORALE, CAPITOLO, getProfilo, padronanzaCompleta, pianoMateria, giornoRoma } from '../../lib/simulazioni';
import { prossimoCapitolo, maggioranza, type StatoPadronanza, type MotivoCapitolo } from '../../lib/calcoli';
import Emiciclo from '../../components/Emiciclo.astro';
import StatoCapitolo from '../../components/StatoCapitolo.astro';
import Calendario from '../../components/Calendario.astro';
import FotoMateria from '../../components/FotoMateria.astro';
import { immagineMateria } from '../../lib/immagini';

export const prerender = false;

const m = (await getMaterie()).find((x) => x.slug === Astro.params.slug);
if (!m) return new Response('Materia non trovata', { status: 404 });

const foto = immagineMateria(m.slug);
const base = m.appunti ? `/appunti/${m.appunti.slug}` : null;
const mb = m.appunti?.pdf ? (m.appunti.pdf.bytes / 1024 / 1024).toLocaleString('it-IT', { maximumFractionDigits: 1 }) : null;
const primoCapitolo = m.appunti?.capitoli.find((c) => !/indice|mappa/i.test(c.titolo)) ?? m.appunti?.capitoli[0];
const voti = await getVoti();
const voto = m.codice ? voti.get(m.codice) : undefined;
const kit = m.codice ? await getKit(m.codice) : null;
const lavoro = m.codice ? await ultimoLavoro('kit', m.codice) : null;
const agente = await statoAgenti();
const kitAggiornato = !!(kit && m.appunti && kit.impronta === m.appunti.impronta);
const inLavorazione = !!lavoro && (lavoro.stato === 'in_coda' || lavoro.stato === 'in_corso');
const banca = m.codice ? await contaBanca(m.codice) : null;
const profilo = m.codice ? await getProfilo(m.codice) : null;
const lavoroDomande = m.codice ? await ultimoLavoro('domande', m.codice) : null;
const domandeInLavorazione = !!lavoroDomande && (lavoroDomande.stato === 'in_coda' || lavoroDomande.stato === 'in_corso');
const simulazioni = m.codice ? await storico(m.codice, 8) : [];
const nonFinite = simulazioni.filter((s) => s.stato === 'in_corso').length;
const scritto = m.esame.tipo === 'Scritto';
const oraleEsame = m.esame.tipo === 'Orale';
const giornoBreve = (iso: string) => new Date(iso).toLocaleDateString('it-IT', { day: 'numeric', month: 'short', timeZone: 'Europe/Rome' });
const giorno = (iso: string) => new Date(iso).toLocaleDateString('it-IT', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Rome' });
const ESITI: Record<string, string> = {
  'in-coda': "Richiesta inviata: l'agente locale preparerà il kit appena è acceso.",
  'gia-in-coda': 'Il kit è già in preparazione.',
  'senza-appunti': 'Servono gli appunti per preparare il kit.',
  'senza-kit': 'Prepara prima il kit d\'esame: le domande nascono da lì.',
  'domande-in-coda': "Richiesta inviata: l'agente locale preparerà nuove domande appena è acceso.",
  'profilo-salvato': "Istruzioni salvate: valgono per le prossime domande e correzioni.",
  'senza-domande': 'La banca di domande è vuota: preparala prima.',
  'simulazione-eliminata': 'Simulazione eliminata dallo storico.',
  'non-finite-eliminate': 'Simulazioni da finire eliminate dallo storico.',
};
const ESITI_APPELLO: Record<string, string> = {
  'appello-salvato': 'Calendario aggiornato.',
  'appello-tolto': 'Data tolta: il calendario non c\'è più.',
  'appello-senza-data': 'Scrivi la data dell\'appello per fare il calendario.',
};
// Aula della materia: un seggio per argomento del kit; i capitoli sono i gruppi.
const allenabile = !!(m.codice && kit && (scritto || oraleEsame));
const aula = allenabile ? await padronanzaCompleta(m.codice!, oraleEsame ? 'orale' : 'scritto') : null;
const argomenti = aula?.argomenti ?? [];
const minimo = oraleEsame ? CAPITOLO.minimoOrale : CAPITOLO.minimo;
const ORDINE_STATI: StatoPadronanza[] = ['solido', 'in-crescita', 'debole', 'mai-provato'];
const conteggi = Object.fromEntries(ORDINE_STATI.map((st) => [st, argomenti.filter((a) => a.stato === st).length])) as Record<StatoPadronanza, number>;
const magg = maggioranza(argomenti.length, conteggi.solido);
const haProvato = argomenti.some((a) => a.risposte > 0);
const prossimo = prossimoCapitolo(argomenti.map((a) => ({ ...a, file: a.id, pronto: true })));
const MOTIVI: Record<MotivoCapitolo, string> = {
  debole: "è l'argomento più debole",
  'mai-provato': 'non è ancora uscito in nessuna simulazione',
  'in-crescita': 'è il meno sicuro tra quelli in crescita',
  'da-rinfrescare': 'è il solido che non ripassi da più tempo',
};
const percento = (q: number | null) => (q === null ? '' : `${Math.round(q * 100)}%`);
const dettaglio = (c: { stato: StatoPadronanza; quota: number | null; risposte: number; ultima: string | null }) =>
  c.stato === 'mai-provato' ? 'Nessuna risposta ancora' : `${percento(c.quota)} dei punti, ${c.risposte} ${c.risposte === 1 ? 'risposta' : 'risposte'}, ultima il ${giorno(c.ultima!)}`;
const PAROLE: Record<StatoPadronanza, string> = { solido: 'solido', 'in-crescita': 'in crescita', debole: 'debole', 'mai-provato': 'mai provato' };
// Gruppi: un capitolo degli appunti con i suoi argomenti (un argomento su due capitoli compare in entrambi).
const gruppi = (m.appunti?.capitoli ?? []).map((c) => ({
  ...c,
  argomenti: argomenti.filter((a) => a.capitoli.includes(c.file)),
  padronanza: aula?.capitoli.get(c.file) ?? null,
}));
// Calendario fino all'appello: piano a ritroso sui capitoli con argomenti del kit.
const piano = m.codice && profilo && kit ? await pianoMateria(m, profilo, aula?.capitoli) : null;
const oggi = giornoRoma(new Date());
const titoloAula = !haProvato ? "L'aula è ancora vuota" : magg.raggiunta ? 'Hai la maggioranza' : 'Non hai ancora la maggioranza';

const esitoCodice = Astro.url.searchParams.get('esito') ?? '';
const capitoloInAttesa = m.appunti?.capitoli.find((c) => c.file === Astro.url.searchParams.get('capitolo'));
const argomentoInAttesa = argomenti.find((a) => a.id === Astro.url.searchParams.get('argomento'));
const nomeAttesa = argomentoInAttesa?.titolo ?? capitoloInAttesa?.titolo;
const esito =
  esitoCodice === 'in-preparazione' && nomeAttesa
    ? `Su «${nomeAttesa}» ci sono ancora poche domande: le ho chieste all'agente. ${agente.online ? 'Ci vogliono uno o due minuti; la pagina si aggiorna da sola.' : "Partiranno quando accendi l'agente sul PC."}`
    : ESITI[esitoCodice];
---

<Base title={m.breve}>
  <header class:list={['testata', { 'testata--con-foto': foto }]} style={`--c: var(--materia-${m.colore})`}>
    <div class="testata__testo">
    <a class="testata__indietro" href="/materie">Tutte le materie</a>
    <p class="etichetta"><span>{m.anno}º anno · {m.periodo}{m.date && <span class="etichetta__date"> · {m.date}</span>}</span></p>
    <h1>{m.nome}</h1>
    <div class="cluster meta">
      {voto ? <Badge stato="superato" label={`Superato · ${votoTesto(voto)}`} /> : <Badge stato={statoMateria(m, voti)} />}
      <TipoEsame tipo={m.esame.tipo} dalCatalogo={m.esame.dalCatalogo} />
      <span class="num">{m.cfu}&nbsp;CFU</span>
      {m.docenti.length > 0 && <span>{m.docenti.join(', ')}</span>}
    </div>
    {m.appunti && (
      <div class="azioni">
        {banca && banca.totale > 0 && (scritto || oraleEsame) && <a class="btn btn--primary btn--largo azione-principale" href="#simula" data-tasto="s">Simula l'esame <span class="tasto" aria-hidden="true">S</span></a>}
        {primoCapitolo && <a class:list={['btn', { 'btn--primary': !(banca && banca.totale > 0 && (scritto || oraleEsame)) }]} href={`${base}/${primoCapitolo.file}`}>Appunti</a>}
        {m.appunti.pdf && (
          <a class="btn" href={`${base}/${m.appunti.pdf.file}`} download>
            PDF <span class="muted num">{mb}&nbsp;MB</span>
          </a>
        )}
      </div>
    )}
    </div>
    {foto && <div class="testata__foto"><FotoMateria immagine={foto} sizes="(min-width: 800px) 290px, calc(100vw - 44px)" priorita /></div>}
  </header>

  <div class="colonne">
    <div class="principale">
      <section class="stack gruppi-sez" aria-labelledby="appunti">
        <h2 id="appunti">{aula ? 'Capitoli e argomenti' : 'Appunti'}</h2>
        {m.appunti && base ? (
          <ol class="gruppi">
            {gruppi.map((g) =>
              g.argomenti.length === 0 ? (
                <li class="gruppo gruppo--semplice">
                  <a class="gruppo__titolo" href={`${base}/${g.file}`}>{g.titolo}</a>
                </li>
              ) : (
                <li class:list={['gruppo', { 'gruppo--attesa': g.padronanza?.inPreparazione }]} data-attesa={g.argomenti.some((a) => a.inPreparazione) ? '1' : undefined}>
                  <a class="gruppo__lettura" href={`${base}/${g.file}`}>{g.titolo}</a>
                  <details>
                    <summary>
                      <span class="gruppo__testa">
                        <span class="gruppo__titolo-testo">{g.argomenti.length} argomenti<span class="visually-hidden"> di {g.titolo}</span></span>
                        <span class="gruppo__seggi" role="img" aria-label={`${g.argomenti.length} argomenti: ${ORDINE_STATI.map((st) => `${g.argomenti.filter((a) => a.stato === st).length} ${PAROLE[st]}`).join(', ')}`}>
                          {g.argomenti.map((a) => <i class={`s s-${a.stato}`} title={`${a.titolo}: ${PAROLE[a.stato]}`}></i>)}
                        </span>
                      </span>
                    </summary>
                    <div class="gruppo__corpo">
                      <div class="gruppo__azioni">
                        <a href={`${base}/${g.file}`}>Leggi il capitolo</a>
                        <form method="post" action="/api/simulazioni" class="allena-form">
                      <input type="hidden" name="codice" value={m.codice!} />
                      <input type="hidden" name="formato" value="breve" />
                      <input type="hidden" name="capitolo" value={g.file} />
                      {oraleEsame && <input type="hidden" name="modalita" value="orale" />}
                      {oraleEsame && agente.online && <input type="hidden" name="dal_vivo" value="1" />}
                          <button class="allena allena--capitolo" type="submit" disabled={g.padronanza?.inPreparazione}>Allena tutto il capitolo</button>
                        </form>
                      </div>
                      <ul class="argomenti">
                        {g.argomenti.map((a) => (
                          <li class="argomento">
                            <span class="argomento__titolo">{a.titolo}</span>
                            <span class="argomento__stato" title={dettaglio(a)}>
                              {a.inPreparazione ? <span class="attesa">domande in preparazione</span> : <StatoCapitolo stato={a.stato} />}
                              {a.quota !== null && !a.inPreparazione && <span class="argomento__quota num">{percento(a.quota)}</span>}
                            </span>
                            <form method="post" action="/api/simulazioni" class="allena-form">
                      <input type="hidden" name="codice" value={m.codice!} />
                      <input type="hidden" name="formato" value="breve" />
                      <input type="hidden" name="argomento" value={a.id} />
                      {oraleEsame && <input type="hidden" name="modalita" value="orale" />}
                      {oraleEsame && agente.online && <input type="hidden" name="dal_vivo" value="1" />}
                              <button class="allena" type="submit" disabled={a.inPreparazione} aria-label={`Allena: ${a.titolo}`} title={a.domande < minimo ? "Poche domande: le chiedo all'agente" : `${a.nuove} domande mai uscite`}>Allena</button>
                            </form>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </details>
                </li>
              ),
            )}
          </ol>
        ) : (
          <p class="vuoto pannello">Gli appunti di questa materia non sono ancora pronti.</p>
        )}
        {aula && (
          <p class="nota-padronanza">
            Il livello viene dalle risposte corrette delle simulazioni: sotto il 60% dei punti l'argomento è debole, dal 90% è solido (servono almeno due domande aperte o equivalenti); le risposte più vecchie pesano meno. "Allena" fa {oraleEsame ? `un orale di ${profilo?.domandeOrale ?? ORALE.aperte} domande` : `${CAPITOLO.scritto.multiple} multiple e ${CAPITOLO.scritto.aperte} aperta`} solo su quell'argomento o capitolo.
          </p>
        )}
      </section>
      {m.codice && profilo && kit && m.appunti && (
        <details class="piano-appello" open={!!profilo.dataAppello || !!ESITI_APPELLO[esitoCodice]}>
          <summary>{profilo.dataAppello ? "Calendario fino all’appello" : "Pianifica l’appello"}</summary>
        <Calendario
          codice={m.codice}
          capitoli={m.appunti.capitoli}
          dataAppello={profilo.dataAppello}
          giorniStudio={profilo.giorniStudio}
          piano={piano}
          oggi={oggi}
          esito={ESITI_APPELLO[Astro.url.searchParams.get('esito') ?? '']}
        />
        </details>
      )}

      {aula && (
        <details class="preparazione" open={haProvato || esitoCodice === 'in-preparazione'}>
          <summary>La tua preparazione <span>{conteggi.solido} di {argomenti.length} argomenti solidi</span></summary>
        <section class="aula" id="aula" aria-labelledby="aula-titolo">
          <h2 id="aula-titolo" class="aula__titolo">{titoloAula}</h2>
          {esitoCodice === 'in-preparazione' && esito && <p class="aula__attesa" role="status">{esito}</p>}
          <Emiciclo seggi={argomenti.map((a) => ({ stato: a.stato, titolo: a.titolo }))} />
          <div class="aula__esito">
            <p class="aula__numero"><strong>{conteggi.solido}</strong> su {magg.soglia} per la maggioranza</p>
            <p class="aula__nota">Ogni seggio è un argomento del kit d'esame ({argomenti.length}). {magg.raggiunta ? 'Sei pronto: tieni i seggi allenandoli.' : `Te ne mancano ${magg.mancano} solidi.`}</p>
          </div>
          <ul class="aula__legenda">
            {ORDINE_STATI.map((st) => <li><StatoCapitolo stato={st} /> <span class="num">{conteggi[st]}</span></li>)}
          </ul>
          {prossimo && (
            <form method="post" action="/api/simulazioni" class="aula__ordine">
              <input type="hidden" name="codice" value={m.codice!} />
              <input type="hidden" name="formato" value="breve" />
              <input type="hidden" name="argomento" value={prossimo.capitolo.id} />
              {oraleEsame && <input type="hidden" name="modalita" value="orale" />}
              {oraleEsame && agente.online && <input type="hidden" name="dal_vivo" value="1" />}
              <p>
                <span class="aula__ordine-etichetta">Da allenare</span>
                <strong>{prossimo.capitolo.titolo}</strong>
                <span>Lo alleni perché {MOTIVI[prossimo.motivo]}{prossimo.capitolo.quota !== null && ` (${percento(prossimo.capitolo.quota)} dei punti)`}.</span>
              </p>
              <button class="btn btn--aula" type="submit" disabled={prossimo.capitolo.inPreparazione}>{prossimo.capitolo.inPreparazione ? 'Domande in preparazione' : 'Allena questo argomento'}</button>
            </form>
          )}
        </section>
        </details>
      )}

    </div>

    <aside class="stack laterale">
      <section class="pannello simula" id="simula" aria-labelledby="simula-titolo">
        <h2 id="simula-titolo">Simulazione d'esame</h2>
        {!scritto && !oraleEsame ? (
          <p class="muted">Per questo tipo d'esame la simulazione non è ancora disponibile.</p>
        ) : !kit ? (
          <p class="muted">Prima serve il kit d'esame: dalle sue rubriche nascono le domande.</p>
        ) : banca && banca.totale > 0 ? (
          oraleEsame ? (
          <form method="post" action="/api/simulazioni" class="avvio">
            <input type="hidden" name="codice" value={m.codice!} />
            <input type="hidden" name="modalita" value="orale" />
            <input type="hidden" name="formato" value="breve" />
            <label class="vivo">
              <input type="checkbox" name="dal_vivo" value="1" checked={agente.online} disabled={!agente.online} />
              <span><strong>Dal vivo</strong>: dopo ogni risposta il docente può farti una domanda di approfondimento{!agente.online && ' (serve l\'agente locale acceso)'}.</span>
            </label>
            <p>Interrogazione di {profilo?.domandeOrale ?? ORALE.aperte} domande: le ascolti, rispondi a voce, la trascrizione arriva in pochi secondi. L'audio non viene salvato.</p>
            <button class="btn btn--primary" type="submit">Inizia l'orale</button>
            <p class="muted piccolo num">Domande pronte: {banca.nuoveAperte} mai uscite su {banca.aperte}. Quando scarseggiano, l'agente ne prepara altre da solo.</p>
          </form>
          ) : (
          <form method="post" action="/api/simulazioni" class="avvio">
            <input type="hidden" name="codice" value={m.codice!} />
            <div class="formati" role="radiogroup" aria-label="Formato">
              {(Object.keys(FORMATI) as (keyof typeof FORMATI)[]).map((k, i) => (
                <label class="formato">
                  <input type="radio" name="formato" value={k} checked={i === 0} />
                  <span class="formato__nome">{FORMATI[k].etichetta}</span>
                  <span class="muted num">{k === 'completo' && profilo ? profilo.multipleScritto + profilo.aperteScritto : FORMATI[k].multiple + FORMATI[k].aperte} domande · {FORMATI[k].minuti} min</span>
                </label>
              ))}
            </div>
            <button class="btn btn--primary" type="submit">Inizia</button>
            <p class="muted piccolo num">Domande pronte: {banca.nuoveMultiple + banca.nuoveAperte} mai uscite su {banca.totale}. Quando scarseggiano, l'agente ne prepara altre da solo.</p>
          </form>
          )
        ) : domandeInLavorazione ? (
          <p><Badge stato="in-coda" label={lavoroDomande!.stato === 'in_corso' ? 'Domande in preparazione' : 'Domande in coda'} /></p>
        ) : (
          <form method="post" action="/api/lavori">
            <input type="hidden" name="codice" value={m.codice!} />
            <input type="hidden" name="tipo" value="domande" />
            <p class="muted">Il kit è pronto: chiedi all'agente locale le prime domande (circa 18, su pochi argomenti; poi si rifornisce da solo).</p>
            <button class="btn" type="submit">Prepara le domande</button>
          </form>
        )}
        {lavoroDomande?.stato === 'errore' && <p class="kit__errore">Preparazione delle domande non riuscita: {lavoroDomande.errore}</p>}
        {simulazioni.length > 0 && (
          <>
          <table class="storico">
            <caption class="visually-hidden">Ultime simulazioni</caption>
            <thead>
              <tr><th scope="col">Data</th><th scope="col">Prova</th><th scope="col">Esito</th><th scope="col"><span class="visually-hidden">Azioni</span></th></tr>
            </thead>
            <tbody>
              {simulazioni.map((s) => {
                const tipo = s.modalita === 'orale' ? 'Orale' : s.capitolo || s.argomento ? 'Mirata' : FORMATI[s.formato as keyof typeof FORMATI]?.etichetta ?? s.formato;
                const bersaglio = s.capitolo ? m.appunti?.capitoli.find((c) => c.file === s.capitolo)?.titolo ?? s.capitolo : s.argomento ? argomenti.find((a) => a.id === s.argomento)?.titolo ?? s.argomento : null;
                return (
                  <tr class:list={{ 'storico--aperta': s.stato === 'in_corso' }}>
                    <td class="num storico__data">{giornoBreve(s.creata)}</td>
                    <td class="storico__prova">
                      <a href={`/simulazioni/${s.id}`}>{tipo}</a>
                      {bersaglio && <span class="muted">{bersaglio}</span>}
                    </td>
                    <td class="num storico__esito">
                      {s.stato === 'corretta' ? `${s.voto}/30` : s.stato === 'in_correzione' ? 'In correzione' : <a href={`/simulazioni/${s.id}`}>Riprendi</a>}
                    </td>
                    <td class="storico__azione">
                      <form method="post" action={`/api/simulazioni/${s.id}/elimina`} onsubmit="return confirm('Eliminare questa simulazione dallo storico?')">
                        <button type="submit" class="elimina" aria-label={`Elimina la simulazione del ${giorno(s.creata)}`} title="Elimina">
                          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                        </button>
                      </form>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          {nonFinite > 1 && (
            <form method="post" action="/api/simulazioni/non-finite" class="storico__pulisci" onsubmit={`return confirm('Eliminare le ${nonFinite} simulazioni da finire?')`}>
              <input type="hidden" name="codice" value={m.codice!} />
              <button type="submit" class="link">Elimina le {nonFinite} da finire</button>
            </form>
          )}
          </>
        )}
      </section>
      <details class="pannello kit" id="kit" open={inLavorazione || !!esito || lavoro?.stato === 'errore'}>
        <summary>Kit d’esame <span>{inLavorazione ? 'In preparazione' : kitAggiornato ? 'Pronto' : kit ? 'Da aggiornare' : 'Da preparare'}</span></summary>
        <div class="kit__corpo">
        {esito && esitoCodice !== 'in-preparazione' && <p class="kit__esito" role="status">{esito}</p>}
        {!m.appunti ? (
          <p class="muted">Si prepara dagli appunti: per ora non ci sono.</p>
        ) : (
          <>
            {inLavorazione ? (
              <p class="kit__stato"><Badge stato="in-coda" label={lavoro!.stato === 'in_corso' ? 'In preparazione' : 'In coda'} /></p>
            ) : kit ? (
              kitAggiornato ? (
                <p class="kit__stato kit__stato--ok">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  Pronto: {kit.nuclei} nuclei, del {giorno(kit.generato)}
                </p>
              ) : (
                <p class="kit__stato kit__stato--avviso">Gli appunti sono cambiati dopo il kit del {giorno(kit.generato)}: aggiornalo.</p>
              )
            ) : (
              <p class="muted">Non ancora preparato. Il kit raccoglie concetti, autori, nessi e la rubrica di correzione: da lì nascono le simulazioni.</p>
            )}
            {lavoro?.stato === 'errore' && <p class="kit__errore">Ultimo tentativo non riuscito: {lavoro.errore}</p>}
            <form method="post" action="/api/lavori">
              <input type="hidden" name="codice" value={m.codice!} />
              <button class="btn" type="submit" disabled={inLavorazione}>
                {kit ? 'Aggiorna il kit' : 'Prepara il kit'}
              </button>
            </form>
            <p class="kit__agente">
              <Badge stato={agente.online ? 'online' : 'offline'} label={agente.online ? 'Agente online' : 'Agente offline'} />
              <a href="/agente">Come avviarlo</a>
            </p>
          </>
        )}
        </div>
      </details>

      {m.codice && profilo && (
        <details class="pannello istruzioni" id="istruzioni" open={esitoCodice === 'profilo-salvato'}>
          <summary>Istruzioni d'esame {profilo.istruzioni && <span class="muted">· attive</span>}</summary>
          <form method="post" action="/api/profili">
            <input type="hidden" name="codice" value={m.codice} />
            <label class="campo">
              <span>Come si svolge l'esame e come deve comportarsi il docente</span>
              <textarea name="istruzioni" rows="7" maxlength="4000" placeholder="Es.: il docente parte sempre da una definizione e poi chiede collegamenti tra capitoli; vuole articoli della Costituzione citati con il numero; domande brevi a catena; severo sul lessico giuridico; niente domande sulle legende.">{profilo.istruzioni}</textarea>
            </label>
            {oraleEsame && (
              <label class="campo">
                <span>Prima domanda, sempre uguale (facoltativa)</span>
                <textarea name="domanda_apertura" rows="3" maxlength="600" placeholder="Es.: Quale presidente della Repubblica hai approfondito? Parti dai suoi discorsi e collegali ai temi del corso.">{profilo.domandaApertura}</textarea>
                <small class="muted">Esce sempre per prima nell'orale completo e conta tra le domande; dal vivo il docente rilancia con collegamenti al programma partendo da quello che dici.</small>
              </label>
            )}
            <div class="numeri">
              {oraleEsame ? (
                <label class="campo"><span>Domande per orale</span><input type="number" name="domande_orale" min="1" max="8" value={profilo.domandeOrale} /></label>
              ) : (
                <>
                  <label class="campo"><span>Multiple (completo)</span><input type="number" name="multiple_scritto" min="0" max="30" value={profilo.multipleScritto} /></label>
                  <label class="campo"><span>Aperte (completo)</span><input type="number" name="aperte_scritto" min="0" max="8" value={profilo.aperteScritto} /></label>
                </>
              )}
            </div>
            <p class="muted piccolo">Valgono per le domande generate da ora in poi e per tutte le correzioni.</p>
            <button class="btn" type="submit">Salva istruzioni</button>
          </form>
          {banca && banca.totale > 0 && !domandeInLavorazione && (
            <form method="post" action="/api/lavori" class="aggiungi">
              <input type="hidden" name="codice" value={m.codice} />
              <input type="hidden" name="tipo" value="domande" />
              <button class="link" type="submit">Prepara subito altre domande con queste istruzioni</button>
            </form>
          )}
        </details>
      )}
    </aside>
  </div>

  <section class="stack esame" aria-labelledby="esame">
    <h2 id="esame">L'esame</h2>
    <p class="esame__testo">
      {m.esame.dettagli ?? (m.esame.dalCatalogo
        ? "Il catalogo indica solo il tipo d'esame: il programma dettagliato non è ancora pubblicato."
        : "Dettagli non disponibili nella scheda dell'insegnamento.")}
    </p>
    {m.programma.length > 0 && (
      <details class="sezione pannello">
        <summary>Programma <span class="muted num">{m.programma.length} temi</span></summary>
        <ul>{m.programma.map((voce) => <li>{voce}</li>)}</ul>
      </details>
    )}
    {m.obiettivi && (
      <details class="sezione pannello">
        <summary>Obiettivi</summary>
        <p>{m.obiettivi}</p>
      </details>
    )}
    {m.url && <p><a href={m.url} rel="noopener" target="_blank">Scheda ufficiale UniBg{m.codice && ` (${m.codice})`}</a></p>}
  </section>
</Base>

<script>
  // Domande di un capitolo in preparazione: ricarica ogni 20 secondi finché l'agente non le consegna.
  if (document.querySelector('[data-attesa]')) {
    const ricarica = () => {
      const t = document.activeElement as HTMLElement | null;
      if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
      const u = new URL(location.href);
      u.searchParams.delete('esito');
      u.hash = 'aula';
      history.replaceState(null, '', u);
      location.reload();
    };
    window.setInterval(ricarica, 20_000);
  }

  // Scorciatoia: S porta alla simulazione (spenta mentre scrivi in un campo).
  document.addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() !== 's' || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    const azione = document.querySelector<HTMLElement>('[data-tasto="s"]');
    if (!azione) return;
    e.preventDefault();
    azione.click();
  });
</script>

