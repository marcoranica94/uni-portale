---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import TipoEsame from '../../components/TipoEsame.astro';
import { getMaterie } from '../../lib/percorso';
import { getVoti, statoMateria, votoTesto } from '../../lib/voti';
import { getKit, ultimoLavoro, statoAgenti } from '../../lib/coda';
import { contaBanca, storico, FORMATI, ORALE, getProfilo } from '../../lib/simulazioni';

export const prerender = false;

const m = (await getMaterie()).find((x) => x.slug === Astro.params.slug);
if (!m) return new Response('Materia non trovata', { status: 404 });

const base = m.appunti ? `/appunti/${m.appunti.slug}` : null;
const mb = m.appunti?.pdf ? (m.appunti.pdf.bytes / 1024 / 1024).toLocaleString('it-IT', { maximumFractionDigits: 1 }) : null;
const primoCapitolo = m.appunti?.capitoli.find((c) => !/indice|mappa/i.test(c.titolo)) ?? m.appunti?.capitoli[0];
const voti = await getVoti();
const voto = m.codice ? voti.get(m.codice) : undefined;
const kit = m.codice ? await getKit(m.codice) : null;
const lavoro = m.codice ? await ultimoLavoro('kit', m.codice) : null;
const agente = await statoAgenti();
const kitAggiornato = !!(kit && m.appunti && kit.impronta === m.appunti.impronta);
const inLavorazione = !!lavoro && (lavoro.stato === 'in_coda' || lavoro.stato === 'in_corso');
const banca = m.codice ? await contaBanca(m.codice) : null;
const profilo = m.codice ? await getProfilo(m.codice) : null;
const lavoroDomande = m.codice ? await ultimoLavoro('domande', m.codice) : null;
const domandeInLavorazione = !!lavoroDomande && (lavoroDomande.stato === 'in_coda' || lavoroDomande.stato === 'in_corso');
const simulazioni = m.codice ? await storico(m.codice) : [];
const scritto = m.esame.tipo === 'Scritto';
const oraleEsame = m.esame.tipo === 'Orale';
const giorno = (iso: string) => new Date(iso).toLocaleDateString('it-IT', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Rome' });
const ESITI: Record<string, string> = {
  'in-coda': "Richiesta inviata: l'agente locale preparerà il kit appena è acceso.",
  'gia-in-coda': 'Il kit è già in preparazione.',
  'senza-appunti': 'Servono gli appunti per preparare il kit.',
  'senza-kit': 'Prepara prima il kit d\'esame: le domande nascono da lì.',
  'domande-in-coda': "Richiesta inviata: l'agente locale preparerà nuove domande appena è acceso.",
  'profilo-salvato': "Istruzioni salvate: valgono per le prossime domande e correzioni.",
  'senza-domande': 'La banca di domande è vuota: preparala prima.',
  'simulazione-eliminata': 'Simulazione eliminata dallo storico.',
};
const esito = ESITI[Astro.url.searchParams.get('esito') ?? ''];
---

<Base title={m.breve}>
  <header class="testata" style={`--c: var(--materia-${m.colore})`}>
    <p class="etichetta"><span class="punto"></span><span>{m.anno}º anno · {m.periodo}{m.date && <span class="muted"> · {m.date}</span>}</span></p>
    <h1>{m.nome}</h1>
    <div class="cluster meta">
      {voto ? <Badge stato="superato" label={`Superato · ${votoTesto(voto)}`} /> : <Badge stato={statoMateria(m, voti)} />}
      <TipoEsame tipo={m.esame.tipo} dalCatalogo={m.esame.dalCatalogo} />
      <span class="num">{m.cfu}&nbsp;CFU</span>
      {m.docenti.length > 0 && <span>{m.docenti.join(', ')}</span>}
    </div>
    {m.appunti && (
      <div class="azioni">
        {banca && banca.totale > 0 && (scritto || oraleEsame) && <a class="btn btn--primary" href="#simula">Simula l'esame</a>}
        {primoCapitolo && <a class:list={['btn', { 'btn--primary': !(banca && banca.totale > 0 && (scritto || oraleEsame)) }]} href={`${base}/${primoCapitolo.file}`}>Apri gli appunti</a>}
        {m.appunti.pdf && (
          <a class="btn" href={`${base}/${m.appunti.pdf.file}`} download>
            Scarica PDF <span class="muted num">{mb}&nbsp;MB</span>
          </a>
        )}
      </div>
    )}
  </header>

  <div class="colonne">
    <section class="stack" aria-labelledby="appunti">
      <h2 id="appunti">Appunti</h2>
      {m.appunti && base ? (
        <ol class="righe pannello capitoli">
          {m.appunti.capitoli.map((c, i) => (
            <li>
              <a class="capitolo" href={`${base}/${c.file}`}>
                <span class="capitolo__n num">{i + 1}</span>
                <span>{c.titolo}</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="vuoto pannello">Gli appunti di questa materia non sono ancora pronti.</p>
      )}
    </section>

    <aside class="stack laterale">
      <section class="pannello kit" id="kit" aria-labelledby="kit-titolo">
        <h2 id="kit-titolo">Kit d'esame</h2>
        {esito && <p class="kit__esito" role="status">{esito}</p>}
        {!m.appunti ? (
          <p class="muted">Si prepara dagli appunti: per ora non ci sono.</p>
        ) : (
          <>
            {inLavorazione ? (
              <p class="kit__stato"><Badge stato="in-coda" label={lavoro!.stato === 'in_corso' ? 'In preparazione' : 'In coda'} /></p>
            ) : kit ? (
              kitAggiornato ? (
                <p class="kit__stato kit__stato--ok">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  Pronto: {kit.nuclei} nuclei, del {giorno(kit.generato)}
                </p>
              ) : (
                <p class="kit__stato kit__stato--avviso">Gli appunti sono cambiati dopo il kit del {giorno(kit.generato)}: aggiornalo.</p>
              )
            ) : (
              <p class="muted">Non ancora preparato. Il kit raccoglie concetti, autori, nessi e la rubrica di correzione: da lì nascono le simulazioni.</p>
            )}
            {lavoro?.stato === 'errore' && <p class="kit__errore">Ultimo tentativo non riuscito: {lavoro.errore}</p>}
            <form method="post" action="/api/lavori">
              <input type="hidden" name="codice" value={m.codice!} />
              <button class="btn" type="submit" disabled={inLavorazione}>
                {kit ? 'Aggiorna il kit' : 'Prepara il kit'}
              </button>
            </form>
            <p class="kit__agente">
              <Badge stato={agente.online ? 'online' : 'offline'} label={agente.online ? 'Agente online' : 'Agente offline'} />
              <a href="/agente">Come avviarlo</a>
            </p>
          </>
        )}
      </section>

      <section class="pannello simula" id="simula" aria-labelledby="simula-titolo">
        <h2 id="simula-titolo">Simulazione d'esame</h2>
        {!scritto && !oraleEsame ? (
          <p class="muted">Per questo tipo d'esame la simulazione non è ancora disponibile.</p>
        ) : !kit ? (
          <p class="muted">Prima serve il kit d'esame: dalle sue rubriche nascono le domande.</p>
        ) : banca && banca.totale > 0 ? (
          oraleEsame ? (
          <form method="post" action="/api/simulazioni" class="avvio">
            <input type="hidden" name="codice" value={m.codice!} />
            <input type="hidden" name="modalita" value="orale" />
            <input type="hidden" name="formato" value="breve" />
            <label class="vivo">
              <input type="checkbox" name="dal_vivo" value="1" checked={agente.online} disabled={!agente.online} />
              <span><strong>Dal vivo</strong>: dopo ogni risposta il docente può farti una domanda di approfondimento{!agente.online && ' (serve l\'agente locale acceso)'}.</span>
            </label>
            <p>Interrogazione di {profilo?.domandeOrale ?? ORALE.aperte} domande: le ascolti, rispondi a voce, la trascrizione arriva in pochi secondi. L'audio non viene salvato.</p>
            <button class="btn btn--primary" type="submit">Inizia l'orale</button>
            <p class="muted piccolo num">Domande pronte: {banca.nuoveAperte} mai uscite su {banca.aperte}. Quando scarseggiano, l'agente ne prepara altre da solo.</p>
          </form>
          ) : (
          <form method="post" action="/api/simulazioni" class="avvio">
            <input type="hidden" name="codice" value={m.codice!} />
            <div class="formati" role="radiogroup" aria-label="Formato">
              {(Object.keys(FORMATI) as (keyof typeof FORMATI)[]).map((k, i) => (
                <label class="formato">
                  <input type="radio" name="formato" value={k} checked={i === 0} />
                  <span class="formato__nome">{FORMATI[k].etichetta}</span>
                  <span class="muted num">{k === 'completo' && profilo ? profilo.multipleScritto + profilo.aperteScritto : FORMATI[k].multiple + FORMATI[k].aperte} domande · {FORMATI[k].minuti} min</span>
                </label>
              ))}
            </div>
            <button class="btn btn--primary" type="submit">Inizia</button>
            <p class="muted piccolo num">Domande pronte: {banca.nuoveMultiple + banca.nuoveAperte} mai uscite su {banca.totale}. Quando scarseggiano, l'agente ne prepara altre da solo.</p>
          </form>
          )
        ) : domandeInLavorazione ? (
          <p><Badge stato="in-coda" label={lavoroDomande!.stato === 'in_corso' ? 'Domande in preparazione' : 'Domande in coda'} /></p>
        ) : (
          <form method="post" action="/api/lavori">
            <input type="hidden" name="codice" value={m.codice!} />
            <input type="hidden" name="tipo" value="domande" />
            <p class="muted">Il kit è pronto: chiedi all'agente locale le prime domande (circa 18, su pochi argomenti; poi si rifornisce da solo).</p>
            <button class="btn" type="submit">Prepara le domande</button>
          </form>
        )}
        {lavoroDomande?.stato === 'errore' && <p class="kit__errore">Preparazione delle domande non riuscita: {lavoroDomande.errore}</p>}
        {simulazioni.length > 0 && (
          <ul class="storico">
            {simulazioni.map((s) => (
              <li>
                <a href={`/simulazioni/${s.id}`}>
                  <span>{giorno(s.creata)} · {s.modalita === 'orale' ? 'Orale' : FORMATI[s.formato as keyof typeof FORMATI]?.etichetta ?? s.formato}</span>
                  <span class="num storico__esito">
                    {s.stato === 'corretta' ? `${s.voto}/30` : s.stato === 'in_correzione' ? 'In correzione' : 'Da finire'}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
      {m.codice && profilo && (
        <details class="pannello istruzioni" id="istruzioni" open={!profilo.istruzioni}>
          <summary>Istruzioni d'esame {profilo.istruzioni && <span class="muted">· attive</span>}</summary>
          <form method="post" action="/api/profili">
            <input type="hidden" name="codice" value={m.codice} />
            <label class="campo">
              <span>Come si svolge l'esame e come deve comportarsi il docente</span>
              <textarea name="istruzioni" rows="7" maxlength="4000" placeholder="Es.: il docente parte sempre da una definizione e poi chiede collegamenti tra capitoli; vuole articoli della Costituzione citati con il numero; domande brevi a catena; severo sul lessico giuridico; niente domande sulle legende.">{profilo.istruzioni}</textarea>
            </label>
            <div class="numeri">
              {oraleEsame ? (
                <label class="campo"><span>Domande per orale</span><input type="number" name="domande_orale" min="1" max="8" value={profilo.domandeOrale} /></label>
              ) : (
                <>
                  <label class="campo"><span>Multiple (completo)</span><input type="number" name="multiple_scritto" min="0" max="30" value={profilo.multipleScritto} /></label>
                  <label class="campo"><span>Aperte (completo)</span><input type="number" name="aperte_scritto" min="0" max="8" value={profilo.aperteScritto} /></label>
                </>
              )}
            </div>
            <p class="muted piccolo">Valgono per le domande generate da ora in poi e per tutte le correzioni.</p>
            <button class="btn" type="submit">Salva istruzioni</button>
          </form>
          {banca && banca.totale > 0 && !domandeInLavorazione && (
            <form method="post" action="/api/lavori" class="aggiungi">
              <input type="hidden" name="codice" value={m.codice} />
              <input type="hidden" name="tipo" value="domande" />
              <button class="link" type="submit">Prepara subito altre domande con queste istruzioni</button>
            </form>
          )}
        </details>
      )}
    </aside>
  </div>

  <section class="stack esame" aria-labelledby="esame">
    <h2 id="esame">L'esame</h2>
    <p class="esame__testo">
      {m.esame.dettagli ?? (m.esame.dalCatalogo
        ? "Il catalogo indica solo il tipo d'esame: il programma dettagliato non è ancora pubblicato."
        : "Dettagli non disponibili nella scheda dell'insegnamento.")}
    </p>
    {m.programma.length > 0 && (
      <details class="sezione pannello">
        <summary>Programma <span class="muted num">{m.programma.length} temi</span></summary>
        <ul>{m.programma.map((voce) => <li>{voce}</li>)}</ul>
      </details>
    )}
    {m.obiettivi && (
      <details class="sezione pannello">
        <summary>Obiettivi</summary>
        <p>{m.obiettivi}</p>
      </details>
    )}
    {m.url && <p><a href={m.url} rel="noopener" target="_blank">Scheda ufficiale UniBg{m.codice && ` (${m.codice})`}</a></p>}
  </section>
</Base>

<style>
  .testata {
    display: grid;
    gap: var(--space-3);
  }
  .etichetta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
  }
  .testata h1 {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
  }
  .meta {
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .azioni {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }
  .colonne {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 900px) {
    .colonne {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }
  .capitolo {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) var(--space-4);
    min-height: 48px;
    color: var(--color-ink);
    text-decoration: none;
  }
  .capitolo:hover {
    background: var(--color-surface-muted);
    color: var(--color-accent);
  }
  .capitoli > li:first-child .capitolo {
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .capitoli > li:last-child .capitolo {
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .capitolo__n {
    min-width: 1.5rem;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    text-align: right;
  }
  .vuoto {
    padding: var(--space-5);
    color: var(--color-ink-muted);
  }
  .laterale {
    gap: var(--space-4);
  }
  .kit,
  .simula {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .kit form {
    margin: 0;
  }
  .kit__esito {
    color: var(--color-accent);
    font-weight: var(--weight-medium);
  }
  .kit__stato {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-medium);
  }
  .kit__stato svg {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .kit__stato--ok {
    color: var(--color-success);
  }
  .kit__stato--avviso {
    color: var(--color-warning);
  }
  .kit__errore {
    color: var(--color-danger);
    font-size: var(--text-sm);
  }
  .kit__agente {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--border);
    font-size: var(--text-sm);
  }
  .simula form {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .formati {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .formato {
    position: relative;
    display: grid;
    gap: 2px;
    padding: var(--space-3);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: var(--text-sm);
  }
  .formato input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .formato:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }
  .formato:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .formato__nome {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }
  .avvio .btn--primary {
    justify-self: start;
  }
  .piccolo {
    font-size: var(--text-sm);
  }
  .vivo {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-3);
    background: var(--color-accent-soft);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .vivo input {
    width: 20px;
    height: 20px;
    flex: none;
    margin-top: 1px;
    accent-color: var(--color-accent);
  }
  .vivo:has(input:disabled) {
    background: var(--color-surface-muted);
    color: var(--color-ink-muted);
    cursor: not-allowed;
  }
  .istruzioni {
    padding: 0 var(--space-5);
  }
  .istruzioni summary {
    min-height: var(--tap-min);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }
  .istruzioni form {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    margin: 0;
  }
  .istruzioni .aggiungi {
    padding-top: 0;
  }
  .campo {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-muted);
  }
  .campo textarea,
  .campo input {
    font: inherit;
    font-size: var(--text-base);
    color: var(--color-ink);
    background: var(--color-surface-muted);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    width: 100%;
  }
  .campo input {
    min-height: var(--tap-min);
    max-width: 8rem;
  }
  .numeri {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .link {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: underline;
    cursor: pointer;
  }
  .storico {
    list-style: none;
    margin: 0;
    padding: var(--space-3) 0 0;
    border-top: var(--border);
    display: grid;
  }
  .storico a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    font-size: var(--text-sm);
    color: var(--color-ink);
    text-decoration: none;
  }
  .storico a:hover {
    color: var(--color-accent);
  }
  .storico__esito {
    font-weight: var(--weight-semibold);
  }
  .esame {
    max-width: 72ch;
  }
  .esame__testo {
    line-height: 1.6;
  }
  .sezione {
    padding: 0 var(--space-4);
  }
  .sezione summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-min);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }
  .sezione[open] summary {
    border-bottom: var(--border);
  }
  .sezione ul,
  .sezione p {
    margin: var(--space-3) 0 var(--space-4);
  }
  .sezione ul {
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }
</style>
