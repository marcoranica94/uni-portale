---
import Base from '../../layouts/Base.astro';
import CartaMateria from '../../components/CartaMateria.astro';
import { getMaterie } from '../../lib/percorso';
import { creditiImmagini } from '../../lib/immagini';

const materie = await getMaterie();
const conAppunti = materie.filter((m) => m.appunti);
const anni = [1, 2, 3].map((anno) => ({ anno, voci: materie.filter((m) => m.anno === anno && !m.appunti) })).filter((a) => a.voci.length);
---

<Base title="Materie">
  <header class="intro"><h1>Materie</h1><p>Appunti e allenamento, nello stesso posto.</p></header>
  <section class="biblioteca" aria-labelledby="con-appunti">
    <div class="titolo-sezione"><h2 id="con-appunti">Con appunti pronti</h2><span>{conAppunti.length} materie</span></div>
    <div class="corsi">{conAppunti.map((m) => <CartaMateria materia={m} />)}</div>
    {!conAppunti.length && <p class="muted">I materiali compariranno qui quando saranno pronti.</p>}
  </section>
  <section class="piano" aria-labelledby="piano-titolo">
    <div class="titolo-sezione"><h2 id="piano-titolo">Nel piano di studi</h2><a href="/percorso">Apri il percorso</a></div>
    {anni.map((a) => (
      <details class="anno" open={a.anno === 1}>
        <summary>{a.anno}º anno <span>{a.voci.length} materie</span></summary>
        <ul>{a.voci.map((m) => <li><a href={`/materie/${m.slug}`}><span>{m.nome}</span><span class="num">{m.cfu}&nbsp;CFU</span></a></li>)}</ul>
      </details>
    ))}
  </section>
  <details class="crediti" id="crediti">
    <summary>Fotografie e crediti</summary>
    <ul>{creditiImmagini.map((f) => <li><a href={f.fonte}>{f.autore}</a>. {f.urlLicenza ? <a href={f.urlLicenza}>{f.licenza}</a> : f.licenza}. Immagine ridimensionata e ritagliata nella presentazione.</li>)}</ul>
    <p>Le fotografie identificano le materie e non illustrano le tesi degli appunti. I ritagli dell’immagine di Montecitorio mantengono la licenza CC BY-SA 3.0.</p>
  </details>
</Base>

<style>
  .intro { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 24px; }
  .intro p { font-size: var(--text-sm); color: var(--color-ink-muted); }
  .biblioteca, .piano { display: grid; gap: 22px; }
  .titolo-sezione { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .titolo-sezione h2 { font-size: var(--text-xl); font-weight: var(--weight-medium); }
  .titolo-sezione > span, .titolo-sezione > a { font-size: var(--text-sm); color: var(--color-ink-muted); }
  .corsi { display: grid; gap: 30px; }
  .anno { border-top: var(--border); }
  .anno summary { display: flex; align-items: center; gap: 12px; min-height: 60px; cursor: pointer; font-size: var(--text-lg); font-weight: var(--weight-medium); list-style: none; }
  .anno summary::-webkit-details-marker { display: none; }
  .anno summary::after { content: '+'; font-size: 22px; font-weight: 400; }
  .anno[open] summary::after { content: '−'; }
  .anno summary span { margin-left: auto; font-size: var(--text-sm); font-weight: 400; color: var(--color-ink-muted); }
  .anno ul { list-style: none; margin: 0; padding: 0; }
  .anno li + li { border-top: var(--border); }
  .anno li a { display: flex; justify-content: space-between; align-items: center; gap: 24px; min-height: 60px; padding: 12px 0; color: var(--color-ink); text-decoration: none; }
  .anno li a > span:last-child { flex: none; color: var(--color-ink-muted); font-size: var(--text-sm); }
  .anno li a:hover { color: var(--color-accent); }
  .crediti { max-width: 75ch; color: var(--color-ink-muted); font-size: var(--text-sm); }
  .crediti summary { min-height: var(--tap-min); cursor: pointer; }
  .crediti ul { padding-left: 20px; display: grid; gap: 12px; }
  @media (min-width: 800px) { .corsi { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; } }
</style>
