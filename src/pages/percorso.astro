---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import TipoEsame from '../components/TipoEsame.astro';
import { getMaterie, ORDINE_PERIODI, CFU_TOTALI } from '../lib/percorso';
import { getVoti, statoMateria, votoTesto } from '../lib/voti';

export const prerender = false;

const voti = await getVoti();

const materie = await getMaterie();
const anni = [1, 2, 3].map((anno) => {
  const delAnno = materie.filter((m) => m.anno === anno);
  // Una scelta vincolata vale per un solo esame: conta i CFU una volta sola.
  const cfu = delAnno.reduce((s, m, i, arr) => {
    if (m.sceltaVincolata && arr.slice(0, i).some((x) => x.sceltaVincolata)) return s;
    return s + m.cfu;
  }, 0);
  const periodi = ORDINE_PERIODI.map((p) => ({ periodo: p, voci: delAnno.filter((m) => m.periodo === p) })).filter((g) => g.voci.length);
  return { anno, cfu, periodi, aa: `${2025 + anno}/${String(26 + anno).padStart(2, '0')}` };
});
---

<Base title="Percorso">
  <header class="stack intro">
    <p class="eyebrow">Curriculum Economico-giuridico · coorte 2026/27</p>
    <h1>Percorso</h1>
    <p class="muted">Tre anni, {CFU_TOTALI} CFU. Gli esami segnati con * hanno solo l'indicazione generica del catalogo: il programma non è ancora pubblicato.</p>
  </header>

  <div class="anni">
    {anni.map((a) => (
      <section class="anno" aria-labelledby={`anno-${a.anno}`}>
        <header class="anno__head">
          <h2 id={`anno-${a.anno}`}>{a.anno}º anno</h2>
          <span class="muted num">a.a. {a.aa} · {a.cfu} CFU</span>
        </header>
        {a.periodi.map((g) => (
          <div class="periodo">
            <h3 class="eyebrow">{g.periodo}</h3>
            <ul class="lista">
              {g.voci.map((m) => (
                <li class:list={['voce', { 'voce--scelta': m.sceltaVincolata }]} style={`--c: var(--materia-${m.colore}); --c-soft: var(--materia-${m.colore}-soft)`}>
                  <a class="voce__nome" href={`/materie/${m.slug}`}>{m.nome}</a>
                  <div class="voce__meta">
                    <Badge stato={statoMateria(m, voti)} label={m.codice && voti.has(m.codice) ? `Superato · ${votoTesto(voti.get(m.codice)!)}` : undefined} />
                    <TipoEsame tipo={m.esame.tipo} dalCatalogo={m.esame.dalCatalogo} />
                    <span class="muted num">{m.cfu} CFU</span>
                    {m.sceltaVincolata && <span class="scelta">uno a scelta</span>}
                    {m.appunti && <span class="appunti">Appunti</span>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </div>
</Base>

<style>
  .intro {
    gap: var(--space-2);
  }
  .anni {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    align-items: start;
  }
  .anno {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }
  .anno__head {
    display: grid;
    gap: var(--space-1);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-ink);
  }
  .periodo {
    display: grid;
    gap: var(--space-2);
  }
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .voce {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: var(--border);
    border-left: 4px solid var(--c);
    border-radius: var(--radius-md);
    min-width: 0;
  }
  .voce--scelta {
    border-style: dashed;
    border-left-style: solid;
  }
  .voce__nome {
    color: var(--color-ink);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .voce__nome:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .voce__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: center;
  }
  .scelta,
  .appunti {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    padding: 1px var(--space-2);
    border-radius: var(--radius-sm);
  }
  .scelta {
    color: var(--color-warning);
    background: var(--color-warning-soft);
  }
  .appunti {
    color: var(--c);
    background: var(--c-soft);
  }
</style>
