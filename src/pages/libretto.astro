---
import Base from '../layouts/Base.astro';
import TipoEsame from '../components/TipoEsame.astro';
import { getMaterie, CFU_TOTALI } from '../lib/percorso';
import { getVoti, riepilogo, votoTesto, formatoMedia, dataLeggibile } from '../lib/voti';

export const prerender = false;

const materie = (await getMaterie()).filter((m) => m.codice);
const voti = await getVoti();
const r = riepilogo(materie, voti);
const daRegistrare = materie.filter((m) => !voti.has(m.codice!));
const oggi = new Date().toISOString().slice(0, 10);
const anni = [1, 2, 3].map((anno) => ({ anno, voci: materie.filter((m) => m.anno === anno) }));

const MESSAGGI: Record<string, { testo: string; ok: boolean }> = {
  salvato: { testo: 'Voto salvato.', ok: true },
  eliminato: { testo: 'Voto eliminato.', ok: true },
  'voto-non-valido': { testo: 'Il voto deve essere un numero intero tra 18 e 30.', ok: false },
  'lode-solo-con-30': { testo: 'La lode si può indicare solo con 30.', ok: false },
  'data-non-valida': { testo: 'Data non valida: usa il selettore della data.', ok: false },
  'insegnamento-non-valido': { testo: 'Insegnamento non trovato nel piano di studi.', ok: false },
};
const esito = MESSAGGI[Astro.url.searchParams.get('esito') ?? ''];
---

<Base title="Libretto">
  <header class="intro">
    <div>
      <p class="eyebrow">Carriera</p>
      <h1>Libretto</h1>
    </div>
  </header>

  {esito && <p class:list={['avviso', esito.ok ? 'avviso--ok' : 'avviso--errore']} role="status">{esito.testo}</p>}

  <section class="riepilogo" aria-label="Riepilogo">
    <div class="cifre">
      <div><span class="valore cifra">{r.cfu}<small> / {CFU_TOTALI}</small></span><span class="etichetta">CFU</span></div>
      <div><span class="valore cifra">{formatoMedia(r.media)}</span><span class="etichetta">Media ponderata</span></div>
      <div><span class="valore cifra">{r.baseLaurea ?? '–'}{r.baseLaurea !== null && <small> / 110</small>}</span><span class="etichetta">Base di laurea</span></div>
      <div><span class="valore cifra">{r.superati}<small> / {materie.length}</small></span><span class="etichetta">Esami</span></div>
    </div>
    <div class="tacche" role="img" aria-label={`${r.cfu} CFU su ${CFU_TOTALI}: ${r.superati} esami superati su ${materie.length}`}>
      {materie.map((m) => {
        const v = voti.get(m.codice!);
        return <i class:list={{ fatta: v, lode: v?.lode }} style={`flex-grow: ${m.cfu}`} title={`${m.breve} · ${m.cfu} CFU`}></i>;
      })}
    </div>
    <p class="tacche__legenda">Una tacca per esame, larga quanto i suoi CFU; piena quando è superato.</p>
  </section>

  <details class="registra">
    <summary class="btn btn--primary">Registra un voto</summary>
    <form method="post" action="/api/voti" class="modulo pannello">
      <input type="hidden" name="azione" value="salva" />
      <label class="campo campo--largo">
        <span>Insegnamento</span>
        <select name="codice" id="codice" required>
          {daRegistrare.map((m) => <option value={m.codice!}>{m.nome} · {m.anno}º anno · {m.cfu} CFU</option>)}
        </select>
      </label>
      <label class="campo">
        <span>Voto</span>
        <select name="voto" id="voto">
          {Array.from({ length: 13 }, (_, i) => 30 - i).map((v) => <option value={v}>{v}</option>)}
        </select>
      </label>
      <label class="campo">
        <span>Data</span>
        <input type="date" name="data" id="data" value={oggi} max={oggi} required />
      </label>
      <div class="campo campo--largo spunte">
        <label><input type="checkbox" name="lode" id="lode" /> Lode</label>
        <label><input type="checkbox" name="idoneo" id="idoneo" /> Idoneità senza voto</label>
      </div>
      <label class="campo campo--largo">
        <span>Note (facoltative)</span>
        <input type="text" name="note" id="note" maxlength="500" />
      </label>
      <div class="campo--largo">
        <button class="btn btn--primary" type="submit">Salva voto</button>
      </div>
    </form>
  </details>

  {anni.map((a) => (
    <section class="stack anno" aria-labelledby={`anno-${a.anno}`}>
      <h2 id={`anno-${a.anno}`}>{a.anno}º anno</h2>
      <ul class="righe esami">
        {a.voci.map((m) => {
          const v = voti.get(m.codice!);
          return (
            <li class:list={['esame', { 'esame--fatto': v }]} style={`--c: var(--materia-${m.colore})`}>
              <span class="punto"></span>
              <div class="esame__testo">
                <a class="esame__nome" href={`/materie/${m.slug}`}>{m.nome}</a>
                <span class="esame__meta">
                  <TipoEsame tipo={m.esame.tipo} dalCatalogo={m.esame.dalCatalogo} />
                  <span class="num">{m.cfu}&nbsp;CFU</span>
                  {m.sceltaVincolata && <span>uno a scelta</span>}
                  {v && <span class="num">{dataLeggibile(v.data)}</span>}
                </span>
              </div>
              <div class="esame__voto">
                {v ? (
                  <>
                    <span class:list={['voto', 'cifra', { 'voto--lode': v.lode }]} aria-label={`Superato con ${votoTesto(v)}`}>
                      {v.lode ? (
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.8l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.6l-3.8 2 .7-4.3-3.1-3 4.3-.6z" fill="currentColor" /></svg>
                      ) : (
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      )}
                      {v.lode ? <>30<span class="lode">e lode</span></> : votoTesto(v)}
                    </span>
                    <form method="post" action="/api/voti" class="elimina" onsubmit="return confirm('Eliminare questo voto?')">
                      <input type="hidden" name="azione" value="elimina" />
                      <input type="hidden" name="codice" value={m.codice!} />
                      <button type="submit" class="link">Elimina</button>
                    </form>
                  </>
                ) : (
                  <span class="muted" aria-label="Da sostenere">–</span>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  ))}

  <p class="nota">Medie stimate: la lode vale 30 (il Regolamento non lo specifica). Alla base di laurea si aggiungono fino a 5 punti per la tesi e 1 per un periodo all'estero.</p>
</Base>

<script>
  // Lode solo con 30; con l'idoneità voto e lode non si usano.
  const voto = document.getElementById('voto') as HTMLSelectElement | null;
  const lode = document.getElementById('lode') as HTMLInputElement | null;
  const idoneo = document.getElementById('idoneo') as HTMLInputElement | null;
  const aggiorna = () => {
    if (!voto || !lode || !idoneo) return;
    voto.disabled = idoneo.checked;
    lode.disabled = idoneo.checked || voto.value !== '30';
    if (lode.disabled) lode.checked = false;
  };
  voto?.addEventListener('change', aggiorna);
  idoneo?.addEventListener('change', aggiorna);
  aggiorna();
</script>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .avviso {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: var(--weight-medium);
  }
  .avviso--ok {
    color: var(--color-success);
    background: var(--color-success-soft);
  }
  .avviso--errore {
    color: var(--color-danger);
    background: var(--color-danger-soft);
  }
  /* Cifre monumentali in riga, separate da filetti; sotto, la barra dei CFU a tacche */
  .riepilogo {
    display: grid;
    gap: var(--space-3);
  }
  .cifre {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: var(--border);
  }
  .cifre > div {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    padding: var(--space-4) var(--space-3) var(--space-4) 0;
  }
  .cifre > div + div {
    padding-left: var(--space-4);
    border-left: var(--border);
  }
  .valore {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    line-height: 1;
  }
  .valore small {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    letter-spacing: 0;
  }
  .etichetta {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .tacche {
    display: flex;
    gap: 3px;
    height: 12px;
  }
  .tacche i {
    flex-basis: 0;
    min-width: 4px;
    border-radius: 2px;
    background: var(--color-raised);
    box-shadow: inset 0 0 0 1px var(--color-rule);
  }
  .tacche i.fatta {
    background: var(--color-success);
    box-shadow: none;
  }
  .tacche i.lode {
    background: var(--color-lode);
  }
  .tacche__legenda {
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }
  @media (max-width: 640px) {
    .cifre {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cifre > div:nth-child(3) {
      padding-left: 0;
      border-left: none;
    }
    .cifre > div:nth-child(n + 3) {
      border-top: var(--border);
    }
  }
  .registra > summary {
    list-style: none;
    width: max-content;
  }
  .registra > summary::-webkit-details-marker {
    display: none;
  }
  .registra[open] > summary {
    background: var(--color-surface);
    color: var(--color-ink);
    border-color: var(--color-rule-strong);
  }
  .modulo {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    padding: var(--space-5);
  }
  .campo {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-muted);
    min-width: 0;
  }
  .campo--largo {
    grid-column: 1 / -1;
  }
  .spunte {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .spunte label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    font-size: var(--text-base);
    color: var(--color-ink);
  }
  .campo select,
  .campo input[type='date'],
  .campo input[type='text'] {
    font: inherit;
    font-size: var(--text-base);
    color: var(--color-ink);
    background: var(--color-surface-muted);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-md);
    min-height: var(--tap-min);
    padding: 0 var(--space-3);
    width: 100%;
  }
  input[type='checkbox'] {
    width: 20px;
    height: 20px;
    accent-color: var(--color-accent);
  }
  .anno {
    gap: var(--space-2);
  }
  /* Esami come righe di un registro: filetti, niente riquadri */
  .esami {
    border-block: var(--border);
  }
  .esame {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) 0;
    min-height: 60px;
  }
  .esame__testo {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .esame__nome {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.2;
    font-weight: var(--weight-semibold);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .esame__nome:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .esame__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .esame__voto {
    display: grid;
    justify-items: end;
    gap: 2px;
    min-width: 3rem;
  }
  .voto {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    color: var(--color-success);
    white-space: nowrap;
  }
  /* 30 e lode: oro caldo, stella, "e lode" in corsivo serif. Un traguardo, non un'etichetta qualsiasi. */
  .voto--lode {
    color: var(--color-lode);
    padding: 2px var(--space-2);
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
  }
  .lode {
    margin-left: 0.3em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-base);
    letter-spacing: 0;
  }
  .voto svg {
    width: 16px;
    height: 16px;
  }
  .elimina {
    margin: 0;
  }
  .link {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-decoration: underline;
    cursor: pointer;
  }
  .link:hover {
    color: var(--color-danger);
  }
  .nota {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
</style>
