---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { getMaterie } from '../../lib/percorso';
import { getSimulazione, FORMATI, ORALE } from '../../lib/simulazioni';
import OraleInCorso from '../../components/OraleInCorso.astro';
import MetricheParlato from '../../components/MetricheParlato.astro';
import type { EsposizioneModello } from '../../shared/schemi';
import { statoAgenti } from '../../lib/coda';
import { capitoliDi } from '../../lib/calcoli';

export const prerender = false;

const dati = await getSimulazione(String(Astro.params.id));
if (!dati) return new Response('Simulazione non trovata', { status: 404 });
const { sim, risposte } = dati;
const m = (await getMaterie()).find((x) => x.codice === sim.codice);
const orale = sim.modalita === 'orale';
const formato = orale ? { etichetta: ORALE.etichetta } : FORMATI[sim.formato];
const esposizione = sim.esposizione ? (JSON.parse(sim.esposizione) as EsposizioneModello) : null;
const scadenza = Date.parse(sim.creata) + sim.minuti * 60_000;
const agente = sim.stato === 'in_correzione' ? await statoAgenti() : null;
const appunti = m?.appunti ? `/appunti/${m.appunti.slug}` : null;
const titoloPagina = (file: string) => m?.appunti?.capitoli.find((c) => c.file === file)?.titolo ?? file;
const lettera = (i: number) => String.fromCharCode(65 + i);
const n = (x: number | null) => (x === null ? '–' : x.toLocaleString('it-IT', { maximumFractionDigits: 1 }));
const sufficiente = (sim.voto ?? 0) >= 18;
---

<Base title={`Simulazione · ${m?.breve ?? sim.codice}`}>
  <header class="intro" style={`--c: var(--materia-${m?.colore ?? 1})`}>
    <p class="etichetta"><span class="punto"></span><a href={m ? `/materie/${m.slug}` : '/'}>{m?.nome ?? sim.codice}</a></p>
    <h1>{sim.stato === 'in_corso' ? (orale ? 'Interrogazione orale' : 'Simulazione scritta') : orale ? "Risultato dell'orale" : 'Risultato della simulazione'}</h1>
    {sim.capitolo && <p class="solo-capitolo">Solo il capitolo <a href={`${appunti}/${sim.capitolo}`}>{titoloPagina(sim.capitolo)}</a></p>}
    <p class="muted">{formato.etichetta}{orale && sim.dal_vivo ? ' dal vivo' : ''} · {risposte.length} domande{orale ? ' · rispondi a voce, una domanda per volta' : ` · ${sim.minuti} minuti`}</p>
  </header>

  {sim.stato === 'in_corso' && orale ? (
    <OraleInCorso sim={sim} risposte={risposte} />
  ) : sim.stato === 'in_corso' ? (
    <form method="post" action={`/api/simulazioni/${sim.id}/consegna`} class="esame" id="esame" data-id={sim.id} data-scadenza={scadenza}>
      <div class="barra-esame" role="status">
        <span class="progresso num" id="progresso">{risposte.length} domande</span>
        <span class="tempo num" id="tempo" aria-live="off"></span>
      </div>

      {risposte.map((r, i) => (
        <fieldset class="domanda pannello" data-indice={i}>
          <legend class="domanda__numero num">Domanda {r.ordine} di {risposte.length}</legend>
          <p class="domanda__testo">{r.domanda.testo}</p>
          {r.domanda.tipo === 'multipla' ? (
            <div class="opzioni">
              {r.domanda.opzioni.map((o, j) => (
                <label class="opzione">
                  <input type="radio" name={`r-${r.ordine}`} value={j} />
                  <span class="opzione__lettera" title={`Tasto ${j + 1}`}>{lettera(j)}</span>
                  <span>{o}</span>
                </label>
              ))}
            </div>
          ) : (
            <div class="aperta">
              <textarea name={`r-${r.ordine}`} rows="9" placeholder="Scrivi la risposta come all'esame: definizioni, autori, nessi, esempi." aria-label={`Risposta alla domanda ${r.ordine}`}></textarea>
              <div class="aperta__strumenti">
                <button type="button" class="btn detta" hidden>Detta</button>
                <span class="muted conta num" aria-live="off"></span>
              </div>
            </div>
          )}
        </fieldset>
      ))}

      <nav class="comandi" aria-label="Navigazione tra le domande">
        <button type="button" class="btn" id="indietro">Indietro</button>
        <div class="pallini" id="pallini" aria-hidden="true"></div>
        <button type="button" class="btn btn--primary" id="avanti">Avanti</button>
        <p class="aiuto-tasti" aria-hidden="true"><span class="tasto">1–4</span> risposta · <span class="tasto">←</span> <span class="tasto">→</span> domande</p>
      </nav>

      <div class="consegna pannello" id="consegna">
        <p><strong>Pronto a consegnare?</strong> <span class="muted" id="riepilogo-risposte"></span></p>
        <p class="muted">Le domande a scelta multipla si correggono subito; le aperte le corregge l'agente locale con la rubrica del kit d'esame.</p>
        <button class="btn btn--primary" type="submit">Consegna</button>
      </div>
    </form>
  ) : (
    <>
      <section class="esito pannello" aria-label="Esito">
        {sim.stato === 'in_correzione' ? (
          <>
            <p class="esito__voto esito__voto--attesa">In correzione</p>
            <p>{orale ? "Le risposte sono trascritte: l'agente locale sta valutando contenuto ed esposizione." : <>Scelta multipla: <strong class="num">{n(sim.punti)} su {risposte.filter((r) => r.domanda.tipo === 'multipla').length}</strong>. Le risposte aperte le sta correggendo l'agente locale.</>}</p>
            <p class="cluster">
              <Badge stato={agente?.online ? 'online' : 'offline'} label={agente?.online ? 'Agente online: ricarica tra qualche minuto' : 'Agente offline: la correzione parte quando lo avvii'} />
              <a href="/agente">Come avviarlo</a>
            </p>
          </>
        ) : (
          <>
            <p class:list={['esito__voto num', sufficiente ? 'esito__voto--ok' : 'esito__voto--ko']}>
              {sim.voto}<small>/30</small>
            </p>
            <p class="num"><strong>{n(sim.punti)} punti su {n(sim.massimo)}</strong> · {sufficiente ? 'sufficiente' : 'non sufficiente'} · {orale ? 'stima: 4 punti per domanda' : 'stima: multipla 1 punto, aperta 4 punti'}</p>
            {sim.giudizio && <p class="esito__giudizio">{sim.giudizio}</p>}
            {esposizione && (
              <div class="esposizione">
                <p class="esposizione__voto num"><span class="muted">Esposizione</span> <strong>{String(esposizione.voto).replace('.', ',')}/10</strong></p>
                <div class="esposizione__liste">
                  {esposizione.puntiForza.length > 0 && <div><h3>Funziona</h3><ul class="lista lista--ok">{esposizione.puntiForza.map((x) => <li>{x}</li>)}</ul></div>}
                  {esposizione.daMigliorare.length > 0 && <div><h3>Da migliorare</h3><ul class="lista lista--errore">{esposizione.daMigliorare.map((x) => <li>{x}</li>)}</ul></div>}
                </div>
                <p class="commento">{esposizione.commento}</p>
              </div>
            )}
          </>
        )}
      </section>

      <ol class="risultati">
        {risposte.map((r) => {
          const giusta = r.domanda.tipo === 'multipla' && r.risposta !== null && Number(r.risposta) === r.domanda.corretta;
          return (
            <li class="risultato pannello">
              <div class="risultato__testa">
                <span class="muted num">Domanda {r.ordine}</span>
                {r.punti !== null ? (
                  <span class:list={['punti num', r.punti >= r.massimo ? 'punti--ok' : r.punti > 0 ? 'punti--parziale' : 'punti--ko']}>
                    {r.punti >= r.massimo ? '✓' : r.punti > 0 ? '◐' : '✕'} {n(r.punti)}/{n(r.massimo)}
                  </span>
                ) : (
                  <Badge stato="in-coda" label="In correzione" />
                )}
              </div>
              <p class="risultato__domanda">{r.domanda.testo}</p>

              {r.domanda.tipo === 'multipla' ? (
                <ul class="scelte">
                  {r.domanda.opzioni.map((o, j) => (
                    <li class:list={['scelta', { 'scelta--giusta': j === r.domanda.corretta, 'scelta--sbagliata': r.risposta !== null && Number(r.risposta) === j && !giusta }]}>
                      <span class="opzione__lettera">{lettera(j)}</span>
                      <span>{o}</span>
                      {j === r.domanda.corretta && <span class="scelta__nota">giusta</span>}
                      {r.risposta !== null && Number(r.risposta) === j && !giusta && <span class="scelta__nota">la tua</span>}
                    </li>
                  ))}
                  {r.risposta === null && <li class="muted">Nessuna risposta.</li>}
                </ul>
              ) : (
                <>
                  <blockquote class="tua">{r.risposta ?? <span class="muted">Nessuna risposta.</span>}</blockquote>
                  {r.metriche && <MetricheParlato metriche={r.metriche} />}
                  {r.approfondimento && (
                    <div class="extra">
                      <p class="extra__domanda"><span>Approfondimento del docente:</span> {r.approfondimento}</p>
                      <blockquote class="tua">{r.rispostaExtra ?? <span class="muted">Nessuna risposta.</span>}</blockquote>
                      {r.metricheExtra && <MetricheParlato metriche={r.metricheExtra} />}
                    </div>
                  )}
                  {r.esito && (
                    <div class="rubrica">
                      {r.esito.coperti && r.esito.coperti.length > 0 && (
                        <div><h3>Hai coperto</h3><ul class="lista lista--ok">{r.esito.coperti.map((x) => <li>{x}</li>)}</ul></div>
                      )}
                      {r.esito.mancanti && r.esito.mancanti.length > 0 && (
                        <div><h3>Manca</h3><ul class="lista lista--ko">{r.esito.mancanti.map((x) => <li>{x}</li>)}</ul></div>
                      )}
                      {r.esito.errori && r.esito.errori.length > 0 && (
                        <div><h3>Errori</h3><ul class="lista lista--errore">{r.esito.errori.map((x) => <li>{x}</li>)}</ul></div>
                      )}
                      {r.esito.commento && <p class="commento">{r.esito.commento}</p>}
                    </div>
                  )}
                </>
              )}

              {(r.domanda.spiegazione || r.domanda.rispostaModello) && (
                <details class="approfondisci">
                  <summary>{r.domanda.tipo === 'multipla' ? 'Spiegazione' : 'Risposta modello'}</summary>
                  <p>{r.domanda.tipo === 'multipla' ? r.domanda.spiegazione : r.domanda.rispostaModello}</p>
                </details>
              )}
              {appunti && r.domanda.file && (
                <p class="rileggi">Rileggi: {capitoliDi(r.domanda.file).map((f, i) => <>{i > 0 && ' e '}<a href={`${appunti}/${f}`}>{titoloPagina(f)}</a></>)}{r.domanda.pagine && <span class="muted"> · {r.domanda.pagine}</span>}</p>
              )}
            </li>
          );
        })}
      </ol>

      <div class="fine">
        {m && <a class="btn btn--primary" href={`/materie/${m.slug}#simula`}>Nuova simulazione</a>}
        <form method="post" action={`/api/simulazioni/${sim.id}/elimina`} onsubmit="return confirm('Eliminare questa simulazione dallo storico?')">
          <button type="submit" class="link">Elimina dallo storico</button>
        </form>
      </div>
    </>
  )}
</Base>

<script>
  const form = document.getElementById('esame') as HTMLFormElement | null;
  if (form) {
    const id = form.dataset.id!;
    const chiave = `simulazione:${id}`;
    const domande = Array.from(form.querySelectorAll<HTMLFieldSetElement>('.domanda'));
    const indietro = document.getElementById('indietro') as HTMLButtonElement;
    const avanti = document.getElementById('avanti') as HTMLButtonElement;
    const consegnaBox = document.getElementById('consegna') as HTMLElement;
    const progresso = document.getElementById('progresso') as HTMLElement;
    const pallini = document.getElementById('pallini') as HTMLElement;
    const riepilogo = document.getElementById('riepilogo-risposte') as HTMLElement;
    let attuale = 0;

    form.classList.add('esame--js');

    // Ripristino delle risposte salvate su questo dispositivo
    try {
      const salvate = JSON.parse(localStorage.getItem(chiave) ?? '{}') as Record<string, string>;
      for (const [nome, valore] of Object.entries(salvate)) {
        const campi = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[name="${nome}"]`);
        campi.forEach((c) => {
          if (c instanceof HTMLInputElement && c.type === 'radio') c.checked = c.value === valore;
          else c.value = valore;
        });
      }
    } catch {}

    const valoriCorrenti = () => {
      const fd = new FormData(form);
      const v: Record<string, string> = {};
      fd.forEach((x, k) => {
        if (typeof x === 'string' && x !== '') v[k] = x;
      });
      return v;
    };
    const risposta = (i: number) => {
      const nome = domande[i].querySelector<HTMLInputElement | HTMLTextAreaElement>('[name]')!.name;
      return valoriCorrenti()[nome];
    };

    const disegnaPallini = () => {
      pallini.replaceChildren(
        ...domande.map((_, i) => {
          const b = document.createElement('span');
          b.className = 'pallino' + (i === attuale ? ' pallino--attuale' : '') + (risposta(i) ? ' pallino--fatto' : '');
          return b;
        }),
      );
    };

    const mostra = (i: number) => {
      attuale = Math.max(0, Math.min(domande.length, i));
      domande.forEach((d, j) => (d.hidden = j !== attuale));
      const fine = attuale === domande.length;
      consegnaBox.hidden = !fine;
      indietro.disabled = attuale === 0;
      avanti.hidden = fine;
      avanti.textContent = attuale === domande.length - 1 ? 'Rivedi e consegna' : 'Avanti';
      progresso.textContent = fine ? 'Consegna' : `Domanda ${attuale + 1} di ${domande.length}`;
      const date = domande.filter((_, j) => risposta(j)).length;
      riepilogo.textContent = `${date} risposte date su ${domande.length}.`;
      disegnaPallini();
      window.scrollTo({ top: 0 });
    };

    indietro.addEventListener('click', () => mostra(attuale - 1));
    avanti.addEventListener('click', () => mostra(attuale + 1));

    // Tastiera: 1-4 sceglie la risposta, frecce o J/K tra le domande. Spente mentre scrivi in un campo.
    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target as HTMLElement | null;
      if (t && (t.isContentEditable || /^(TEXTAREA|SELECT)$/.test(t.tagName) || (t instanceof HTMLInputElement && t.type !== 'radio'))) return;
      const tasto = e.key.toLowerCase();
      const n = Number(e.key);
      if (n >= 1 && n <= 9) {
        const scelta = domande[attuale]?.querySelectorAll<HTMLInputElement>('input[type="radio"]')[n - 1];
        if (!scelta) return;
        e.preventDefault();
        scelta.checked = true;
        scelta.dispatchEvent(new Event('input', { bubbles: true }));
        scelta.focus();
      } else if ((e.key === 'ArrowRight' || tasto === 'j') && !avanti.hidden) {
        e.preventDefault();
        mostra(attuale + 1);
      } else if ((e.key === 'ArrowLeft' || tasto === 'k') && !indietro.disabled) {
        e.preventDefault();
        mostra(attuale - 1);
      }
    });

    form.addEventListener('input', (e) => {
      try {
        localStorage.setItem(chiave, JSON.stringify(valoriCorrenti()));
      } catch {}
      const t = e.target as HTMLElement;
      if (t instanceof HTMLTextAreaElement) {
        const conta = t.closest('.aperta')?.querySelector('.conta');
        if (conta) conta.textContent = `${t.value.trim() ? t.value.trim().split(/\s+/).length : 0} parole`;
      }
      disegnaPallini();
    });
    form.addEventListener('submit', () => {
      try {
        localStorage.removeItem(chiave);
      } catch {}
    });

    // Tempo che resta (l'esame non si chiude da solo: avvisa e basta)
    const tempo = document.getElementById('tempo') as HTMLElement;
    const scadenza = Number(form.dataset.scadenza);
    const aggiornaTempo = () => {
      const s = Math.round((scadenza - Date.now()) / 1000);
      if (s <= 0) {
        tempo.textContent = 'Tempo scaduto';
        tempo.classList.add('tempo--scaduto');
        return;
      }
      tempo.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
      tempo.classList.toggle('tempo--poco', s < 120);
    };
    aggiornaTempo();
    setInterval(aggiornaTempo, 1000);

    // Dettatura con il riconoscimento vocale del browser (se disponibile)
    const Riconoscimento = (window as unknown as { SpeechRecognition?: new () => any; webkitSpeechRecognition?: new () => any }).SpeechRecognition ??
      (window as unknown as { webkitSpeechRecognition?: new () => any }).webkitSpeechRecognition;
    if (Riconoscimento) {
      form.querySelectorAll<HTMLButtonElement>('.detta').forEach((b) => {
        b.hidden = false;
        const area = b.closest('.aperta')!.querySelector('textarea')!;
        let rec: any = null;
        b.addEventListener('click', () => {
          if (rec) {
            rec.stop();
            return;
          }
          rec = new Riconoscimento();
          rec.lang = 'it-IT';
          rec.continuous = true;
          rec.interimResults = false;
          rec.onresult = (ev: any) => {
            for (let k = ev.resultIndex; k < ev.results.length; k++) {
              if (ev.results[k].isFinal) area.value = `${area.value}${area.value && !area.value.endsWith(' ') ? ' ' : ''}${ev.results[k][0].transcript.trim()}`;
            }
            area.dispatchEvent(new Event('input', { bubbles: true }));
          };
          rec.onend = () => {
            rec = null;
            b.textContent = 'Detta';
            b.classList.remove('detta--attiva');
          };
          rec.start();
          b.textContent = 'Ferma la dettatura';
          b.classList.add('detta--attiva');
        });
      });
    }

    mostra(0);
  }
</script>

<style>
  .solo-capitolo {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lg);
  }
  .intro {
    display: grid;
    gap: var(--space-2);
  }
  .etichetta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  .etichetta a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .etichetta a:hover {
    text-decoration: underline;
  }
  .esame {
    display: grid;
    gap: var(--space-4);
    max-width: 48rem;
  }
  .barra-esame {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
    font-weight: var(--weight-semibold);
  }
  .tempo {
    font-variant-numeric: tabular-nums;
  }
  .tempo--poco {
    color: var(--color-warning);
  }
  .tempo--scaduto {
    color: var(--color-danger);
  }
  .domanda {
    margin: 0;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    min-width: 0;
  }
  .domanda__numero {
    float: left;
    padding: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-ink-muted);
  }
  .esame--js .domanda__numero {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .aiuto-tasti {
    flex-basis: 100%;
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
    text-align: center;
  }
  @media (hover: none) {
    .aiuto-tasti {
      display: none;
    }
  }
  .domanda__testo {
    clear: both;
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 3.5vw, 1.75rem);
    font-weight: var(--weight-medium);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .opzioni {
    display: grid;
    gap: var(--space-2);
  }
  .opzione {
    position: relative;
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-3) var(--space-4);
    min-height: var(--tap-min);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    line-height: 1.4;
  }
  .opzione:hover {
    background: var(--color-surface-muted);
  }
  .opzione input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .opzione:has(input:checked) {
    border-color: var(--color-primary-edge);
    background: var(--color-accent-soft);
    box-shadow: inset 0 0 0 1px var(--color-primary-edge);
  }
  .opzione:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .opzione__lettera {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-rule-strong);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .opzione:has(input:checked) .opzione__lettera {
    background: var(--color-primary);
    border-color: var(--color-primary-edge);
    color: var(--color-on-primary);
  }
  .aperta {
    display: grid;
    gap: var(--space-2);
  }
  textarea {
    width: 100%;
    font: inherit;
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-ink);
    background: var(--color-surface-muted);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    resize: vertical;
  }
  .aperta__strumenti {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .detta--attiva {
    border-color: var(--color-danger);
    color: var(--color-danger);
  }
  .conta {
    font-size: var(--text-sm);
  }
  .comandi {
    display: none;
  }
  .esame--js .comandi {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
