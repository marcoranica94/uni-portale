---
import Base from '../layouts/Base.astro';
import EmicicloLaurea from '../components/EmicicloLaurea.astro';
import CartaMateria from '../components/CartaMateria.astro';
import { getMaterie, CFU_TOTALI } from '../lib/percorso';
import { getVoti, riepilogo, statoMateria, formatoMedia } from '../lib/voti';
import { statoAgenti, getKit } from '../lib/coda';
import { contaBanca, giorniDiStudio, padronanzaCompleta, padronanzaTutte, seggiPerMateria, appelliFissati, pianoMateria, giornoRoma, FORMATI, ORALE, CAPITOLO } from '../lib/simulazioni';
import { prossimoCapitolo, minutiRipasso, gruppiLaurea, type MotivoCapitolo, type StatoPadronanza } from '../lib/calcoli';
import { riepilogoRipasso } from '../lib/ripasso';

export const prerender = false;

const materie = await getMaterie();
const voti = await getVoti();
const r = riepilogo(materie, voti);
const inCorso = materie.filter((m) => statoMateria(m, voti) === 'in-corso');
const [agente, studio, padronanze, seggi, ripasso, appelli] = await Promise.all([statoAgenti(), giorniDiStudio(), padronanzaTutte(), seggiPerMateria(), riepilogoRipasso(), appelliFissati()]);

// Materia della seduta: quella con il kit pronto e l'appello più vicino; senza appelli fissati
// la prima in corso con il kit, altrimenti la prima con appunti.
const oggi = giornoRoma(new Date());
const conKit = await Promise.all(inCorso.map(async (m) => ({ m, kit: m.codice ? await getKit(m.codice) : null })));
const appelloDi = (m: (typeof inCorso)[number]) => {
  const d = m.codice ? appelli.get(m.codice)?.dataAppello : null;
  return d && d >= oggi ? d : null;
};
const vicina = conKit.filter((x) => x.kit && appelloDi(x.m)).sort((a, b) => appelloDi(a.m)!.localeCompare(appelloDi(b.m)!))[0];
const adesso = vicina ?? conKit.find((x) => x.kit) ?? conKit.find((x) => x.m.appunti) ?? null;
const primoCapitolo = adesso?.m.appunti?.capitoli.find((c) => !/indice|mappa/i.test(c.titolo)) ?? adesso?.m.appunti?.capitoli[0];
const banca = adesso?.m.codice ? await contaBanca(adesso.m.codice) : null;
const orale = adesso?.m.esame.tipo === 'Orale';
const simulabile = !!(adesso && banca && banca.totale > 0 && (orale || adesso.m.esame.tipo === 'Scritto'));

// Padronanza della materia della seduta (argomenti del kit): serve all'ordine del giorno.
const aula = adesso?.m.codice && adesso.kit ? await padronanzaCompleta(adesso.m.codice, orale ? 'orale' : 'scritto') : null;
const argomenti = aula?.argomenti ?? [];
const haProvato = argomenti.some((a) => a.risposte > 0);

// Ordine del giorno: l'argomento da allenare (pronto, cioè con domande in banca); alla prima seduta, l'esame intero.
const minimo = orale ? CAPITOLO.minimoOrale : CAPITOLO.minimo;
// Calendario fino all'appello della materia della seduta: che cosa tocca oggi.
const profiloAppello = adesso?.m.codice ? appelli.get(adesso.m.codice) : undefined;
const piano = adesso && profiloAppello && aula ? await pianoMateria(adesso.m, profiloAppello, aula.capitoli) : null;
const pianoOggi = piano?.giorni.find((g) => g.data === oggi);
// Se il calendario indica capitoli per oggi, l'argomento da allenare si cerca prima lì dentro.
const candidati = argomenti.map((a) => ({ ...a, file: a.id, pronto: a.domande >= minimo && !a.inPreparazione }));
const delGiorno = candidati.filter((a) => a.capitoli.some((c) => pianoOggi?.capitoli.includes(c)));
const sceltaGiorno = prossimoCapitolo(delGiorno);
const scelta = simulabile && haProvato ? (sceltaGiorno && sceltaGiorno.motivo !== 'da-rinfrescare' ? sceltaGiorno : prossimoCapitolo(candidati)) : null;
const mirata = scelta && scelta.motivo !== 'da-rinfrescare' ? scelta : null;
const capitoloDi = (file: string | undefined) => adesso?.m.appunti?.capitoli.find((c) => c.file === file);
const capitoloMirato = mirata ? capitoloDi(mirata.capitolo.capitoli[0]) : undefined;
const percento = (q: number | null) => `${Math.round((q ?? 0) * 100)}%`;
const MOTIVI: Record<MotivoCapitolo, (q: string) => string> = {
  debole: (q) => `È l'argomento più debole: nelle simulazioni hai preso il ${q} dei punti.`,
  'mai-provato': () => 'Non è ancora uscito in nessuna simulazione.',
  'in-crescita': (q) => `Sei al ${q} dei punti: ancora un passo e diventa solido.`,
  'da-rinfrescare': () => '',
};
const minuti = mirata ? (orale ? 15 : CAPITOLO.scritto.minuti) : orale ? ORALE.minuti : FORMATI.breve.minuti;
const appuntiMossa = adesso?.m.appunti ? `/appunti/${adesso.m.appunti.slug}/${capitoloMirato?.file ?? primoCapitolo?.file ?? ''}` : null;

const rigaCalendario = (() => {
  if (!piano || piano.stato === 'passato' || !adesso) return null;
  const tra = piano.mancano === 0 ? "l'appello è oggi" : piano.mancano === 1 ? "l'appello è domani" : `appello tra ${piano.mancano} giorni`;
  const titoli = (pianoOggi?.capitoli ?? []).map((f) => adesso.m.appunti?.capitoli.find((c) => c.file === f)?.titolo ?? f);
  if (titoli.length) return `Da calendario oggi: ${titoli.join(' e ')}; ${tra}.`;
  if (pianoOggi?.tipo === 'prova') return `Da calendario oggi: prova generale su tutto il programma; ${tra}.`;
  return `Oggi è libero da calendario; ${tra}.`;
})();
// Aula della laurea: un seggio per CFU; la maggioranza da conquistare sono tutti i CFU del corso.
const gruppi = gruppiLaurea(materie, voti);
const mancano = Math.max(0, CFU_TOTALI - r.cfu);
const cfuDi = (stato: (typeof gruppi)[number]['stato']) => gruppi.filter((g) => g.stato === stato).reduce((n, g) => n + g.cfu, 0);
const cfuInCorso = cfuDi('in-corso');
const esamiInCorso = gruppi.filter((g) => g.stato === 'in-corso').length;
const titoloAula = mancano === 0 ? 'Laurea completata' : 'La tua laurea';

// Data e settimana del semestre, dalle date ufficiali del piano di studi ("14/09/2026 - 18/12/2026").
const ora = new Date();
const dataEstesa = new Intl.DateTimeFormat('it-IT', { timeZone: 'Europe/Rome', weekday: 'long', day: 'numeric', month: 'long' }).format(ora);
const leggiData = (s: string) => {
  const [g, m, a] = s.split('/').map(Number);
  return new Date(Date.UTC(a, m - 1, g));
};
const semestre = (() => {
  const conDate = inCorso.find((m) => m.periodo === 'I semestre' || m.periodo === 'II semestre') ?? inCorso.find((m) => m.date);
  const date = conDate?.date?.split(' - ');
  if (!conDate || !date || date.length !== 2) return null;
  const inizio = leggiData(date[0]);
  const fine = leggiData(date[1]);
  const settimane = Math.ceil((fine.getTime() - inizio.getTime() + 86_400_000) / (7 * 86_400_000));
  const corrente = Math.floor((ora.getTime() - inizio.getTime()) / (7 * 86_400_000)) + 1;
  if (corrente < 1 || corrente > settimane) return null;
  const nome = conDate.periodo === 'II semestre' ? 'secondo semestre' : conDate.periodo === 'I semestre' ? 'primo semestre' : 'anno';
  const fineLezioni = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(fine);
  return { settimane, corrente, nome, fineLezioni };
})();

// Ripasso degli errori: quante carte oggi, divise per materia.
const ripassoMaterie = [...ripasso.perMateria].map(([codice, n]) => ({ m: materie.find((x) => x.codice === codice), n })).filter((x) => x.m);
const quandoProssima = ripasso.prossima
  ? new Intl.DateTimeFormat('it-IT', { timeZone: 'Europe/Rome', weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(ripasso.prossima))
  : null;

// Materie in corso: barretta degli argomenti del kit (solidi, in crescita, deboli).
const altre = inCorso
  .map((m) => {
    const tot = m.codice ? (seggi.get(m.codice) ?? 0) : 0;
    const p = m.codice ? [...(padronanze.get(m.codice)?.values() ?? [])] : [];
    const n = (s: StatoPadronanza) => p.filter((x) => x.stato === s).length;
    return { m, tot, si: n('solido'), forse: n('in-crescita'), no: n('debole') };
  });
---

<Base title="Uni">
  <header class="seduta">
    <div><p class="seduta__corso">Scienze politiche e strategie globali</p><h1 class="seduta__data">{dataEstesa}</h1></div>
    {semestre && <p class="seduta__settimana">Settimana {semestre.corrente} di {semestre.settimane}<br />{semestre.nome}</p>}
  </header>

  <div class="tavolo">
    <section class="aula" aria-labelledby="aula-titolo">
      <div class="aula__testa"><h2 id="aula-titolo" class="aula__titolo">{titoloAula}</h2><span>{CFU_TOTALI} CFU</span></div>
      <EmicicloLaurea gruppi={gruppi} totale={CFU_TOTALI} />
      <div class="aula__esito">
        <p class="aula__numero"><strong>{r.cfu}</strong> CFU su {CFU_TOTALI}</p>
        <p class="aula__nota">
          {esamiInCorso
            ? `${esamiInCorso === 1 ? 'Un esame in corso' : `${esamiInCorso} esami in corso`}, ${cfuInCorso} CFU da conquistare.`
            : 'Ogni seggio è un CFU: si colora quando superi l\'esame.'}
        </p>
      </div>
      <ul class="aula__legenda">
        <li><svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" class="l-pieno" /></svg>{r.cfu} superati</li>
        <li><svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.3" class="l-anello" /></svg>{cfuInCorso} in corso</li>
        <li><svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.3" class="l-vuoto" /></svg>{CFU_TOTALI - r.cfu - cfuInCorso} da seguire</li>
      </ul>
    </section>

    <div class="lato">
    {adesso && (
      <section class="ordine" aria-labelledby="ordine-titolo">
        <p class="ordine__etichetta">{mirata ? `Da allenare in ${adesso.m.breve}` : `Oggi, ${adesso.m.breve}`}</p>
        <h2 id="ordine-titolo" class="ordine__titolo">
          {mirata ? mirata.capitolo.titolo : simulabile ? (orale ? `Interrogazione di ${adesso.m.breve}` : `Prova scritta di ${adesso.m.breve}`) : `Ripasso di ${adesso.m.breve}`}
        </h2>
        {mirata && capitoloMirato && <p class="ordine__capitolo">{capitoloMirato.titolo}</p>}
        <p class="ordine__testo">
          {mirata
            ? `${MOTIVI[mirata.motivo](percento(mirata.capitolo.quota))} ${orale ? 'Domande a voce solo su questo argomento' : 'Poche domande solo su questo argomento'}, circa ${minuti} minuti.`
            : simulabile
              ? haProvato
                ? `${orale ? 'Tre domande a voce' : 'Sei domande'} su tutto il programma, circa ${minuti} minuti.`
                : `Prima prova: ${orale ? 'tre domande a voce' : 'sei domande'} su tutto il programma, circa ${minuti} minuti, per vedere da dove partire.${orale && agente.online ? ' Il docente rilancia dove resti scoperto.' : ''}`
              : adesso.kit
                ? `Il kit d'esame è pronto: prepara le domande dalla scheda della materia, intanto ripassa dagli appunti.`
                : "Riparti dagli appunti: dal kit d'esame nasceranno le simulazioni."}
        </p>
        {rigaCalendario && <p class="ordine__calendario"><a href={`/materie/${adesso.m.slug}#calendario`}>{rigaCalendario}</a></p>}
        <div class="ordine__azioni">
          {simulabile ? (
            <form method="post" action="/api/simulazioni">
              <input type="hidden" name="codice" value={adesso.m.codice!} />
              <input type="hidden" name="formato" value="breve" />
              {orale && <input type="hidden" name="modalita" value="orale" />}
              {orale && agente.online && <input type="hidden" name="dal_vivo" value="1" />}
              {mirata && <input type="hidden" name="argomento" value={mirata.capitolo.id} />}
              <button class="btn btn--primary btn--largo" type="submit" data-tasto="s">{mirata ? 'Allena questo argomento' : orale ? "Inizia l’orale" : 'Inizia la prova'} <span class="tasto" aria-hidden="true">S</span></button>
            </form>
          ) : (
            appuntiMossa && <a class="btn btn--primary btn--largo" href={appuntiMossa} data-tasto="s">Apri gli appunti <span class="tasto" aria-hidden="true">S</span></a>
          )}
          {simulabile && appuntiMossa ? <a class="btn" href={appuntiMossa}>Appunti</a> : <a class="btn" href={`/materie/${adesso.m.slug}`}>Scheda</a>}
        </div>
        {mirata && (
          <form method="post" action="/api/simulazioni" class="ordine__altro">
            <input type="hidden" name="codice" value={adesso.m.codice!} />
            <input type="hidden" name="formato" value="breve" />
            {orale && <input type="hidden" name="modalita" value="orale" />}
            {orale && agente.online && <input type="hidden" name="dal_vivo" value="1" />}
            <button type="submit">Simula invece l'esame intero</button>
          </form>
        )}
      </section>
    )}

    <section class="ripasso" aria-labelledby="ripasso-titolo">
      <div class="ripasso__testo">
        <h2 id="ripasso-titolo" class="ripasso__titolo">Ripasso di oggi</h2>
        <p>
          {ripasso.oggi > 0
            ? `${ripasso.oggi === 1 ? 'Una domanda sbagliata torna' : `${ripasso.oggi} domande sbagliate tornano`} oggi, circa ${minutiRipasso(ripasso.oggi)} ${minutiRipasso(ripasso.oggi) === 1 ? 'minuto' : 'minuti'}.`
            : ripasso.totale === 0
              ? 'Le domande che sbagli nelle simulazioni tornano qui, il giorno giusto per non dimenticarle.'
              : ripasso.piuTardi > 0
                ? `Fatto per adesso: ${ripasso.piuTardi === 1 ? 'una carta torna' : `${ripasso.piuTardi} carte tornano`} più tardi.`
                : `Fatto. Le prossime carte tornano ${quandoProssima ?? 'domani'}.`}
        </p>
        {ripassoMaterie.length > 1 && (
          <ul class="ripasso__materie">
            {ripassoMaterie.map((x) => (
              <li style={`--c: var(--materia-${x.m!.colore})`}>
                <a href={`/ripasso?materia=${x.m!.slug}`}><span class="punto"></span>{x.m!.breve} <span class="num">{x.n}</span></a>
              </li>
            ))}
          </ul>
        )}
      </div>
      {ripasso.oggi > 0 && (
        <a class="btn btn--largo ripasso__vai" href="/ripasso" data-tasto="r">Ripassa <span class="tasto" aria-hidden="true">R</span></a>
      )}
    </section>

    <a class:list={['agente', { 'agente--acceso': agente.online }]} href="/agente"><span class="agente__luce" aria-hidden="true"></span>{agente.online ? 'Agente locale acceso' : 'Agente locale spento'}<span class="agente__gestisci">Gestisci</span></a>
    </div>
  </div>

  <section class="biblioteca" aria-labelledby="appunti-titolo">
    <div class="titolo-sezione"><h2 id="appunti-titolo">I tuoi appunti</h2><a href="/materie">Tutte le materie</a></div>
    <div class="biblioteca__corsi">
      {materie.filter((m) => m.appunti).map((m) => <CartaMateria materia={m} compatta padronanza={altre.find((x) => x.m.slug === m.slug)} />)}
    </div>
    {altre.some((x) => !x.m.appunti) && (
      <div class="altre"><h3>Altre materie in corso</h3><ul>{altre.filter((x) => !x.m.appunti).map(({ m }) => <li><a href={`/materie/${m.slug}`}>{m.breve}<span>{m.cfu} CFU</span></a></li>)}</ul></div>
    )}
  </section>

  <div class="numeri" aria-label="Riepilogo dello studio">
    {r.media !== null ? <p>Media <a href="/libretto"><strong>{formatoMedia(r.media)}</strong></a>{r.baseLaurea !== null && <> — base di laurea <strong>{r.baseLaurea}/110</strong></>}</p> : <a href="/libretto">Registra il primo voto nel libretto</a>}
    {studio.diFila > 0 && <p><strong>{studio.diFila}</strong> {studio.diFila === 1 ? 'giorno di studio' : 'giorni di studio di fila'}</p>}
  </div>
</Base>

<script>
  // Scorciatoie: S avvia l'ordine del giorno, R il ripasso (spente mentre scrivi in un campo).
  document.addEventListener('keydown', (e) => {
    const tasto = e.key.toLowerCase();
    if ((tasto !== 's' && tasto !== 'r') || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    const azione = document.querySelector<HTMLElement>(`[data-tasto="${tasto}"]`);
    if (!azione) return;
    e.preventDefault();
    azione.click();
  });
</script>

<style>
  .seduta { display: flex; align-items: end; justify-content: space-between; gap: 16px; }
  .seduta__corso { font-size: var(--text-sm); color: var(--color-ink-muted); margin-bottom: 8px; }
  .seduta__data { font-weight: var(--weight-medium); }
  .seduta__data::first-letter { text-transform: uppercase; }
  .seduta__settimana { font-size: var(--text-sm); color: var(--color-ink-muted); text-align: right; flex: none; }
  .tavolo { display: grid; gap: 28px; align-items: stretch; }
  .lato { display: grid; grid-template-columns: minmax(0, 1fr); align-content: center; gap: 20px; grid-row: 1; min-width: 0; }
  .aula { display: flex; flex-direction: column; gap: 16px; padding: 24px; border-radius: var(--radius-aula); background: var(--color-aula); color: var(--color-on-aula); min-width: 0; }
  .aula__testa { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .aula__testa > span { font-size: var(--text-sm); color: var(--color-aula-tenue); }
  .aula__titolo { font-size: var(--text-xl); font-weight: var(--weight-medium); }
  .aula :global(.laurea) { margin-top: 8px; }
  .aula__esito { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 20px; margin-top: auto; }
  .aula__numero { font-size: var(--text-sm); color: var(--color-aula-tenue); font-variant-numeric: tabular-nums; }
  .aula__numero strong { font-size: 2.5rem; font-weight: var(--weight-medium); line-height: 1; color: var(--color-on-aula); margin-right: 6px; }
  .aula__nota { max-width: 25ch; font-size: var(--text-sm); color: var(--color-aula-tenue); }
  .aula__legenda { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 0; padding: 14px 0 0; border-top: 1px solid var(--color-aula-filo); list-style: none; font-size: var(--text-xs); font-variant-numeric: tabular-nums; color: var(--color-aula-tenue); }
  .aula__legenda li { display: inline-flex; align-items: center; gap: 6px; }
  .aula__legenda svg { width: 10px; height: 10px; }
  .l-pieno { fill: var(--color-on-aula); } .l-anello { fill: none; stroke: var(--color-on-aula); stroke-width: 1.6; } .l-vuoto { fill: none; stroke: var(--color-aula-tenue); stroke-width: 1.4; opacity: .6; }
  .ordine { display: grid; grid-template-columns: minmax(0, 1fr); min-width: 0; gap: 12px; padding-bottom: 22px; border-bottom: var(--border); overflow-wrap: anywhere; }
  .ordine__etichetta { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-accent); }
  .ordine__titolo { font-size: clamp(1.75rem, 3vw, 2.375rem); font-weight: var(--weight-medium); line-height: 1.12; letter-spacing: -.015em; max-width: 24ch; }
  .ordine__capitolo { font-size: var(--text-sm); color: var(--color-ink-muted); }
  .ordine__testo { color: var(--color-ink-muted); max-width: 48ch; }
  .ordine__calendario { font-size: var(--text-sm); }
  .ordine__azioni { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 8px; }
  .ordine__azioni form { display: grid; min-width: 0; max-width: 100%; margin: 0; flex: 1 1 13rem; }
  .ordine__altro { margin: 0; }
  .ordine__altro button { min-height: var(--tap-min); padding: 0; border: 0; background: none; font: inherit; font-size: var(--text-sm); color: var(--color-accent); text-decoration: underline; text-underline-offset: .2em; cursor: pointer; }
  .ripasso { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .ripasso__titolo { font-size: var(--text-lg); }
  .ripasso__testo { min-width: 0; }
  .ripasso p { font-size: var(--text-sm); color: var(--color-ink-muted); margin-top: 5px; }
  .ripasso__vai { flex: none; }
  .ripasso__materie { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: var(--text-sm); }
  .ripasso__materie a { display: inline-flex; align-items: center; gap: 6px; min-height: var(--tap-min); }
  .agente { display: inline-flex; align-items: center; gap: 8px; color: var(--color-ink-muted); text-decoration: none; font-size: var(--text-xs); min-height: 32px; }
  .agente__luce { width: 7px; height: 7px; border-radius: 50%; border: 1px solid currentColor; flex: none; }
  .agente--acceso .agente__luce { background: var(--color-success); border-color: var(--color-success); }
  .agente__gestisci { margin-left: auto; text-decoration: underline; text-underline-offset: .2em; }
  .biblioteca { display: grid; gap: 22px; }
  .titolo-sezione { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .titolo-sezione h2 { font-size: var(--text-xl); font-weight: var(--weight-medium); }
  .titolo-sezione a { font-size: var(--text-sm); color: var(--color-ink-muted); }
  .biblioteca__corsi { display: grid; gap: 24px; }
