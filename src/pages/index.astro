---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import TipoEsame from '../components/TipoEsame.astro';
import { getMaterie, CFU_TOTALI } from '../lib/percorso';
import { getVoti, riepilogo, statoMateria } from '../lib/voti';

export const prerender = false;

const materie = await getMaterie();
const voti = await getVoti();
const r = riepilogo(materie, voti);
const inCorso = materie.filter((m) => statoMateria(m, voti) === 'in-corso');
---

<Base title="Uni">
  <header class="stack intro">
    <p class="eyebrow">1º anno · Scienze politiche e strategie globali</p>
    <h1>Oggi</h1>
    <p class="muted">Il ripasso quotidiano arriva con lo Sprint 6; per ora qui trovi le materie in corso.</p>
  </header>

  <section class="summary" aria-label="Riepilogo del percorso">
    <Card tone="accent" title="Ripasso di oggi" eyebrow="Prossima azione">
      <p>Le simulazioni d'esame saranno disponibili da fine dicembre: prima lo scritto di Sociologia, poi l'orale di Diritto pubblico.</p>
    </Card>
    <Card tone="muted" title="CFU conseguiti" eyebrow="Percorso">
      <p class="figure num">{r.cfu} <span class="muted">/ {CFU_TOTALI}</span></p>
      <div class="bar" role="img" aria-label={`${r.cfu} CFU conseguiti su ${CFU_TOTALI}`}><span style={`width: ${Math.round((r.cfu / CFU_TOTALI) * 100)}%`}></span></div>
    </Card>
  </section>

  <section class="stack" aria-labelledby="in-corso">
    <h2 id="in-corso">Materie in corso</h2>
    <div class="grid">
      {inCorso.map((m) => (
        <Card title={m.nome} eyebrow={m.periodo} materia={m.colore} href={`/materie/${m.slug}`}>
          <div class="cluster">
            <Badge stato="in-corso" />
            <TipoEsame tipo={m.esame.tipo} />
            <span class="muted num">{m.cfu} CFU</span>
          </div>
        </Card>
      ))}
    </div>
  </section>
</Base>

<style>
  .intro {
    gap: var(--space-2);
  }
  .summary,
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .figure {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    line-height: 1;
  }
  .figure .muted {
    font-size: var(--text-xl);
  }
  .bar {
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--color-rule);
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    background: var(--color-success);
  }
</style>
