---
/**
 * Card: contenitore di un'unità di contenuto (una materia, un esame, il ripasso di oggi).
 * - `href` rende l'intera card cliccabile (un solo link, accessibile da tastiera).
 * - `tone="accent"` evidenzia l'unica card con l'azione principale della schermata.
 * - `materia` (1-8) colora l'etichetta della materia: il nome resta sempre scritto.
 */
interface Props {
  title?: string;
  eyebrow?: string;
  href?: string;
  tone?: 'plain' | 'muted' | 'accent';
  materia?: 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8;
  headingLevel?: 2 | 3;
  class?: string;
}

const {
  title,
  eyebrow,
  href,
  tone = 'plain',
  materia,
  headingLevel = 3,
  class: className,
} = Astro.props;

const Heading = headingLevel === 2 ? 'h2' : 'h3';
const style = materia
  ? `--card-materia: var(--materia-${materia}); --card-materia-soft: var(--materia-${materia}-soft);`
  : undefined;
---

<article class:list={['card', `card--${tone}`, { 'card--link': href, 'card--materia': materia }, className]} style={style}>
  {(eyebrow || title) && (
    <header class="card__head">
      {eyebrow && <span class="card__eyebrow">{eyebrow}</span>}
      {title && (
        <Heading class="card__title">
          {href ? <a class="card__link" href={href}>{title}</a> : title}
        </Heading>
      )}
    </header>
  )}
  <div class="card__body"><slot /></div>
  {Astro.slots.has('footer') && <footer class="card__foot"><slot name="footer" /></footer>}
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-md);
  }
  .card--muted {
    background: var(--color-surface-muted);
  }
  .card--accent {
    background: var(--color-accent-soft);
    border-color: var(--color-accent);
    border-width: 2px;
  }
  .card__head {
    display: grid;
    gap: var(--space-1);
  }
  .card__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .card--materia .card__eyebrow {
    justify-self: start;
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--card-materia);
    background: var(--card-materia-soft);
    letter-spacing: 0.04em;
  }
  .card__title {
    font-size: var(--text-xl);
    overflow-wrap: anywhere;
  }
  .card__body {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }
  .card__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    padding-top: var(--space-3);
    border-top: var(--border);
  }

  /* Tutta la card è cliccabile tramite il link del titolo */
  .card__link {
    color: inherit;
    text-decoration: none;
  }
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card--link {
    transition: border-color 0.15s;
  }
  .card--link:hover {
    border-color: var(--color-rule-strong);
  }
  .card--link:has(.card__link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .card__link:focus-visible {
    outline: none;
  }
</style>
