---
/**
 * Badge di stato: icona + testo, mai solo colore.
 * Gli stati coprono materie (da seguire, in corso, superato, da sostenere),
 * padronanza (debole, in crescita, solido) e sistema (in coda, online, offline).
 */
export type Stato =
  | 'da-seguire'
  | 'in-corso'
  | 'superato'
  | 'da-sostenere'
  | 'debole'
  | 'in-crescita'
  | 'solido'
  | 'in-coda'
  | 'online'
  | 'offline';

interface Props {
  stato: Stato;
  /** Testo personalizzato; di default l'etichetta dello stato. */
  label?: string;
}

const config: Record<Stato, { label: string; tone: string; icon: 'circle' | 'half' | 'check' | 'clock' | 'alert' | 'dot' | 'cross' }> = {
  'da-seguire': { label: 'Da seguire', tone: 'neutral', icon: 'circle' },
  'in-corso': { label: 'In corso', tone: 'accent', icon: 'half' },
  superato: { label: 'Superato', tone: 'success', icon: 'check' },
  'da-sostenere': { label: 'Da sostenere', tone: 'warning', icon: 'clock' },
  debole: { label: 'Debole', tone: 'danger', icon: 'alert' },
  'in-crescita': { label: 'In crescita', tone: 'warning', icon: 'half' },
  solido: { label: 'Solido', tone: 'success', icon: 'check' },
  'in-coda': { label: 'In coda', tone: 'neutral', icon: 'clock' },
  online: { label: 'Agente online', tone: 'success', icon: 'dot' },
  offline: { label: 'Agente offline', tone: 'neutral', icon: 'cross' },
};

const { stato, label } = Astro.props;
const { label: defaultLabel, tone, icon } = config[stato];
---

<span class:list={['badge', `badge--${tone}`]}>
  <svg class="badge__icon" viewBox="0 0 16 16" aria-hidden="true">
    {icon === 'circle' && <circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" />}
    {icon === 'half' && (
      <>
        <circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M8 2.5a5.5 5.5 0 0 1 0 11z" fill="currentColor" />
      </>
    )}
    {icon === 'check' && <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
    {icon === 'clock' && (
      <>
        <circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M8 5v3.2l2 1.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </>
    )}
    {icon === 'alert' && (
      <>
        <path d="M8 2.5l6 10.5H2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        <path d="M8 6.5v3M8 11.2v.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </>
    )}
    {icon === 'dot' && <circle cx="8" cy="8" r="4" fill="currentColor" />}
    {icon === 'cross' && <path d="M4.5 4.5l7 7M11.5 4.5l-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />}
  </svg>
  <span>{label ?? defaultLabel}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 1px var(--space-2) 1px 5px;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .badge__icon {
    width: 14px;
    height: 14px;
    flex: none;
  }
  .badge--neutral {
    color: var(--color-ink-muted);
    background: transparent;
    border-color: var(--color-rule);
  }
  .badge--accent {
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .badge--success {
    color: var(--color-success);
    background: var(--color-success-soft);
  }
  .badge--warning {
    color: var(--color-warning);
    background: var(--color-warning-soft);
  }
  .badge--danger {
    color: var(--color-danger);
    background: var(--color-danger-soft);
  }
</style>
