---
/** Tipo d'esame con icona (penna = scritto, microfono = orale): mai solo colore. */
import type { TipoEsame } from '../lib/percorso';

interface Props {
  tipo: TipoEsame;
  dalCatalogo?: boolean;
}
const { tipo, dalCatalogo = false } = Astro.props;
---

<span class="tipo" title={dalCatalogo ? 'Indicazione generica del catalogo: programma non ancora pubblicato' : undefined}>
  <svg viewBox="0 0 16 16" aria-hidden="true">
    {tipo === 'Scritto' && <path d="M3 13l1-3.5L10.5 3a1.4 1.4 0 0 1 2 2L6 11.5zM9.5 4l2 2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />}
    {tipo === 'Orale' && (
      <>
        <rect x="6" y="2" width="4" height="7.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M3.8 7.5a4.2 4.2 0 0 0 8.4 0M8 11.8V14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      </>
    )}
    {tipo === 'Relazione e discussione' && <path d="M4 2.5h6l2.5 2.5v8.5H4zM6.5 7.5h4M6.5 10h4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />}
    {tipo === 'Da definire' && <circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2 2" />}
  </svg>
  <span>{tipo}{dalCatalogo && <span class="asterisco" aria-label="(indicazione del catalogo)">*</span>}</span>
</span>

<style>
  .tipo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  svg {
    width: 15px;
    height: 15px;
    flex: none;
  }
  .asterisco {
    color: var(--color-ink-faint);
  }
</style>
