---
/**
 * Ricerca in tutti gli appunti (t036). L'indice lo genera Pagefind dopo la build (pagefind.yml):
 * la pagina è statica, la ricerca gira nel browser e scarica solo i pezzi d'indice che servono.
 * Risultato = capitolo; sotto, le sezioni (titoli di pagina) dove compaiono le parole.
 */
import { getMaterie } from '../lib/percorso';

interface Props { modale?: boolean; }
const { modale = false } = Astro.props;
const Titolo = modale ? 'h2' : 'h1';
const materie = (await getMaterie()).filter((m) => m.appunti);
const colori = Object.fromEntries(materie.map((m) => [m.breve, m.colore]));
---

  <section class="cerca" aria-labelledby="cerca-titolo" data-ricerca data-modale={modale ? 'true' : undefined}>
    <Titolo id="cerca-titolo">Cerca negli appunti</Titolo>
    <form class="cerca__campo" role="search" action="/cerca" method="get">
      <label for="q" class="visually-hidden">Parole da cercare</label>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="Es. decreto-legge, Beck, sussidiarietà" autofocus={!modale} />
    </form>
    <div class="cerca__filtri" id="filtri" role="group" aria-label="Materia" hidden></div>
    <p class="cerca__stato" id="stato" role="status" aria-live="polite">Cerca una parola, un autore o un articolo in {materie.length === 1 ? 'tutti gli appunti' : `tutti gli appunti delle ${materie.length} materie`}.</p>
    <ol class="risultati" id="risultati"></ol>
  </section>

<script define:vars={{ colori }}>
  window.__COLORI__ = colori;
</script>

<script>
  type Sotto = { title: string; url: string; excerpt: string };
  type Dati = { url: string; excerpt: string; meta: { title?: string; materia?: string }; sub_results: Sotto[] };
  type Pagefind = {
    options: (o: Record<string, unknown>) => Promise<void>;
    filters: () => Promise<Record<string, Record<string, number>>>;
    debouncedSearch: (q: string, o?: Record<string, unknown>, ms?: number) => Promise<{ results: { data: () => Promise<Dati> }[] } | null>;
  };

  const colori = (window as unknown as { __COLORI__: Record<string, number> }).__COLORI__;
  const campo = document.getElementById('q') as HTMLInputElement;
  const stato = document.getElementById('stato')!;
  const lista = document.getElementById('risultati')!;
  const filtri = document.getElementById('filtri')!;
  const iniziale = stato.textContent ?? '';
  const modale = document.querySelector<HTMLElement>('[data-ricerca]')?.dataset.modale === 'true';
  let materia = modale ? '' : new URLSearchParams(location.search).get('materia') ?? '';
  let pagefind: Pagefind | null = null;

  const el = (tag: string, cls?: string, testo?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (testo) n.textContent = testo;
    return n;
  };
  // L'estratto di Pagefind è testo già escapato con <mark>: si tengono solo i <mark>.
  const estratto = (html: string) => {
    const p = el('p', 'risultato__estratto');
    p.innerHTML = html.replace(/<(?!\/?mark>)[^>]*>/g, '');
    return p;
  };
  // Il link porta le parole da evidenziare nel capitolo.
  const conParole = (url: string, q: string) => {
    const [base, ancora] = url.split('#');
    const u = new URL(base, location.origin);
    u.searchParams.set('evidenzia', q);
    return u.pathname + u.search + (ancora ? `#${ancora}` : '');
  };

  async function carica() {
    if (pagefind) return pagefind;
    try {
      const percorso = '/pagefind/pagefind.js';
      pagefind = (await import(/* @vite-ignore */ percorso)) as Pagefind;
      await pagefind.options({ excerptLength: 24, noWorker: true }); // indice piccolo: il worker non serve
      const f = (await pagefind.filters()).materia ?? {};
      const nomi = Object.keys(f).sort((a, b) => a.localeCompare(b, 'it'));
      if (nomi.length > 1) {
        filtri.hidden = false;
        filtri.replaceChildren(
          ...['', ...nomi].map((nome) => {
            const b = el('button', 'filtro', nome || 'Tutte') as HTMLButtonElement;
            b.type = 'button';
            b.setAttribute('aria-pressed', String(materia === nome));
            if (nome) b.style.setProperty('--c', `var(--materia-${colori[nome] ?? 1})`);
            b.addEventListener('click', () => {
              materia = nome;
              filtri.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
              cerca();
            });
            return b;
          }),
        );
      }
      return pagefind;
    } catch {
      stato.textContent = "L'indice di ricerca non è disponibile: si crea con la pubblicazione del portale.";
      return null;
    }
  }

  async function cerca() {
    const q = campo.value.trim();
    const u = new URL(location.href);
    q ? u.searchParams.set('q', q) : u.searchParams.delete('q');
    materia ? u.searchParams.set('materia', materia) : u.searchParams.delete('materia');
    if (!modale) history.replaceState(null, '', u);
    if (!q) {
      lista.replaceChildren();
      stato.textContent = iniziale;
      return;
    }
    const pf = await carica();
    if (!pf) return;
    const esito = await pf.debouncedSearch(q, materia ? { filters: { materia } } : {}, 200);
    if (esito === null || campo.value.trim() !== q) return; // superata da una ricerca più recente
    const dati = await Promise.all(esito.results.slice(0, 20).map((r) => r.data()));
    const n = esito.results.length;
    stato.textContent = n
      ? `${n === 1 ? 'Un capitolo' : `${n} capitoli`}${materia ? ` di ${materia}` : ''} con «${q}»${n > 20 ? ', i primi 20' : ''}.`
      : `Nessun capitolo${materia ? ` di ${materia}` : ''} con «${q}». Prova una parola sola o l'inizio della parola (es. «costituz»).`;
    lista.replaceChildren(
      ...dati.map((d) => {
        const li = el('li', 'risultato');
        const testa = el('p', 'risultato__materia');
        testa.style.setProperty('--c', `var(--materia-${colori[d.meta.materia ?? ''] ?? 1})`);
        testa.append(el('span', 'punto'), d.meta.materia ?? '');
        const a = el('a', 'risultato__titolo', d.meta.title ?? d.url) as HTMLAnchorElement;
        a.href = conParole(d.url, q);
        li.append(testa, a);
        const sezioni = d.sub_results.filter((s) => s.url.includes('#')).slice(0, 3);
        if (sezioni.length) {
          const ul = el('ul', 'sezioni');
          for (const s of sezioni) {
            const voce = el('li');
            const link = el('a', 'sezioni__titolo', s.title) as HTMLAnchorElement;
            link.href = conParole(s.url, q);
            voce.append(link, estratto(s.excerpt));
            ul.append(voce);
          }
          li.append(ul);
        } else li.append(estratto(d.excerpt));
        return li;
      }),
    );
  }

  campo.value = modale ? '' : new URLSearchParams(location.search).get('q') ?? '';
  campo.addEventListener('input', cerca);
  campo.form!.addEventListener('submit', (e) => {
    e.preventDefault();
    cerca();
  });
  // Carica l'indice appena la pagina è pronta, così la prima ricerca è immediata.
  const avvia = () => carica().then(() => { if (campo.value) cerca(); });
  if (modale) document.addEventListener('uni:search', avvia);
  else avvia();
</script>

<style>
  .cerca {
    display: grid;
    gap: var(--space-4);
    width: 100%;
    max-width: 44rem;
  }
  .cerca :is(h1, h2) {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
  }
  .cerca__campo {
    position: relative;
    margin: 0;
  }
  .cerca__campo svg {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    width: 22px;
    height: 22px;
    margin-top: -11px;
    color: var(--color-ink-muted);
    pointer-events: none;
  }
  .cerca__campo input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0 var(--space-4) 0 calc(var(--space-4) + 30px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-rule-strong);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-lg);
  }
  .cerca__campo input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .cerca__filtri {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cerca__filtri :global(.filtro) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-rule-strong);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }
  .cerca__filtri :global(.filtro[style])::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--c);
  }
  .cerca__filtri :global(.filtro[aria-pressed='true']) {
    background: var(--color-primary);
    border-color: var(--color-primary-edge);
    color: var(--color-on-primary);
  }
  .cerca__stato {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .risultati {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border);
  }
  .risultati :global(.risultato) {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) 0;
    border-bottom: var(--border);
  }
  .risultati :global(.risultato__materia) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-ink-muted);
  }
  .risultati :global(.risultato__titolo) {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: 1.25;
    color: var(--color-ink);
    text-decoration: none;
  }
  .risultati :global(.risultato__titolo:hover),
  .risultati :global(.sezioni__titolo:hover) {
    text-decoration: underline;
  }
  .risultati :global(.risultato__estratto) {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    max-width: 68ch;
  }
  .risultati :global(mark) {
    background: var(--color-highlight);
    color: var(--color-ink);
    padding: 0 2px;
    border-radius: 2px;
  }
  .risultati :global(.sezioni) {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0 0 0 var(--space-4);
    list-style: none;
    border-left: 2px solid var(--color-rule);
  }
  .risultati :global(.sezioni__titolo) {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    text-decoration: none;
  }
</style>
