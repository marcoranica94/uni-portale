---
/**
 * Simulazione orale in corso: una domanda per volta, lettura ad alta voce, registrazione con forma d'onda,
 * invio al Worker che trascrive (l'audio non viene salvato), coda sul telefono se manca la rete.
 */
import type { Risposta, Simulazione } from '../lib/simulazioni';
import MetricheParlato from './MetricheParlato.astro';

interface Props {
  sim: Simulazione;
  risposte: Risposta[];
}
const { sim, risposte } = Astro.props;
---

<div class="orale" id="orale" data-id={sim.id}>
  <div class="barra-esame" role="status">
    <span class="num" id="progresso">Domanda 1 di {risposte.length}</span>
    <span class="muted">L'audio non viene salvato</span>
  </div>

  {risposte.map((r) => (
    <section class="domanda pannello" data-ordine={r.ordine} data-fatta={r.risposta ? '1' : '0'} aria-label={`Domanda ${r.ordine}`}>
      <p class="domanda__testo">{r.domanda.testo}</p>
      <button type="button" class="btn ascolta">Ascolta la domanda</button>

      <div class="registratore">
        <button type="button" class="rec" aria-pressed="false">
          <span class="rec__icona" aria-hidden="true"></span>
          <span class="rec__testo">Rispondi</span>
        </button>
        <canvas class="onda" width="600" height="80" aria-hidden="true"></canvas>
        <span class="durata num" aria-live="off">0:00</span>
      </div>
      <p class="stato" role="status"></p>

      <div class="trascrizione" hidden={!r.risposta}>
        <h3>Hai detto</h3>
        <blockquote class="testo">{r.risposta}</blockquote>
        <div class="metriche-box">{r.metriche && <MetricheParlato metriche={r.metriche} />}</div>
      </div>
    </section>
  ))}

  <nav class="comandi" aria-label="Navigazione tra le domande">
    <button type="button" class="btn" id="indietro">Indietro</button>
    <button type="button" class="btn btn--primary" id="avanti">Domanda successiva</button>
  </nav>

  <form method="post" action={`/api/simulazioni/${sim.id}/consegna`} class="consegna pannello" id="consegna" hidden>
    <p><strong>Fine dell'interrogazione.</strong> <span class="muted" id="riepilogo"></span></p>
    <p class="muted">L'agente locale valuta il contenuto con la rubrica del kit e l'esposizione con trascrizione e metriche.</p>
    <button class="btn btn--primary" type="submit">Consegna</button>
  </form>
</div>

<script>
  const radice = document.getElementById('orale') as HTMLElement | null;
  if (radice) {
    const id = radice.dataset.id!;
    const sezioni = Array.from(radice.querySelectorAll<HTMLElement>('.domanda'));
    const progresso = document.getElementById('progresso')!;
    const indietro = document.getElementById('indietro') as HTMLButtonElement;
    const avanti = document.getElementById('avanti') as HTMLButtonElement;
    const consegna = document.getElementById('consegna') as HTMLFormElement;
    const riepilogo = document.getElementById('riepilogo')!;
    const MAX_SECONDI = 180;
    let attuale = 0;

    // ---------- Coda sul telefono (IndexedDB) per registrazioni senza rete ----------
    const db = (): Promise<IDBDatabase> =>
      new Promise((ok, ko) => {
        const r = indexedDB.open('uni-orale', 1);
        r.onupgradeneeded = () => r.result.createObjectStore('attesa', { keyPath: 'chiave' });
        r.onsuccess = () => ok(r.result);
        r.onerror = () => ko(r.error);
      });
    const accoda = async (ordine: number, blob: Blob) => {
      const d = await db();
      d.transaction('attesa', 'readwrite').objectStore('attesa').put({ chiave: `${id}:${ordine}`, id, ordine, blob });
    };
    const togli = async (ordine: number) => {
      const d = await db();
      d.transaction('attesa', 'readwrite').objectStore('attesa').delete(`${id}:${ordine}`);
    };
    const inAttesa = async (): Promise<{ ordine: number; blob: Blob }[]> => {
      const d = await db();
      return new Promise((ok) => {
        const r = d.transaction('attesa').objectStore('attesa').getAll();
        r.onsuccess = () => ok((r.result as { id: string; ordine: number; blob: Blob }[]).filter((x) => x.id === id));
        r.onerror = () => ok([]);
      });
    };

    const sezione = (ordine: number) => sezioni.find((s) => Number(s.dataset.ordine) === ordine)!;
    const stato = (s: HTMLElement, testo: string, tipo = '') => {
      const p = s.querySelector('.stato')!;
      p.textContent = testo;
      p.className = `stato ${tipo}`;
    };

    const mostraTrascrizione = (s: HTMLElement, testo: string, m: Record<string, any>) => {
      const box = s.querySelector<HTMLElement>('.trascrizione')!;
      box.hidden = false;
      box.querySelector('.testo')!.textContent = testo;
      const parti = [
        m.paroleAlMinuto ? `${m.paroleAlMinuto} parole/min` : null,
        `${m.pauseLunghe} ${m.pauseLunghe === 1 ? 'pausa lunga' : 'pause lunghe'}`,
        `${m.intercalari} intercalari${m.intercalari ? ` (${Object.keys(m.intercalariUsati).join(', ')})` : ''}`,
        m.avvio !== null ? `avvio ${String(m.avvio).replace('.', ',')} s` : null,
        `${Math.round(m.durata)} s`,
      ].filter(Boolean);
      const ul = document.createElement('ul');
      ul.className = 'metriche';
      parti.forEach((t) => {
        const li = document.createElement('li');
        li.textContent = t as string;
        ul.append(li);
      });
      box.querySelector('.metriche-box')!.replaceChildren(ul);
      s.dataset.fatta = '1';
      aggiornaRiepilogo();
    };

    const invia = async (ordine: number, blob: Blob): Promise<boolean> => {
      const s = sezione(ordine);
      stato(s, 'Trascrizione in corso…');
      try {
        const r = await fetch(`/api/simulazioni/${id}/audio?ordine=${ordine}`, {
          method: 'POST',
          headers: { 'Content-Type': blob.type || 'audio/webm' },
          body: blob,
        });
        const dati = await r.json().catch(() => ({}));
        if (!r.ok) {
          stato(s, dati.errore ?? `Errore ${r.status}: riprova.`, 'stato--errore');
          await togli(ordine);
          return false;
        }
        await togli(ordine);
        stato(s, '');
        mostraTrascrizione(s, dati.trascrizione, dati.metriche);
        return true;
      } catch {
        await accoda(ordine, blob);
        stato(s, 'Nessuna rete: la risposta è salvata sul telefono e parte da sola appena torni online.', 'stato--attesa');
        return false;
      }
    };

    const svuotaCoda = async () => {
      if (!navigator.onLine) return;
      for (const x of await inAttesa()) await invia(x.ordine, x.blob);
    };
    window.addEventListener('online', svuotaCoda);

    // ---------- Lettura della domanda ----------
    const voceItaliana = () => speechSynthesis.getVoices().find((v) => v.lang?.toLowerCase().startsWith('it'));
    sezioni.forEach((s) => {
      const b = s.querySelector<HTMLButtonElement>('.ascolta')!;
      if (!('speechSynthesis' in window)) {
        b.hidden = true;
        return;
      }
      b.addEventListener('click', () => {
        speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(s.querySelector('.domanda__testo')!.textContent ?? '');
        u.lang = 'it-IT';
        const v = voceItaliana();
        if (v) u.voice = v;
        speechSynthesis.speak(u);
      });
    });

    // ---------- Registrazione con forma d'onda ----------
    const tipoAudio = () =>
      ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4', 'audio/ogg;codecs=opus'].find((t) => window.MediaRecorder?.isTypeSupported?.(t)) ?? '';

    sezioni.forEach((s) => {
      const bottone = s.querySelector<HTMLButtonElement>('.rec')!;
      const etichetta = s.querySelector<HTMLElement>('.rec__testo')!;
      const tela = s.querySelector<HTMLCanvasElement>('.onda')!;
      const durata = s.querySelector<HTMLElement>('.durata')!;
      let registratore: MediaRecorder | null = null;
      let flusso: MediaStream | null = null;
      let fermaDisegno = () => {};
      let timer = 0;

      const fine = () => {
        registratore?.state === 'recording' && registratore.stop();
      };

      bottone.addEventListener('click', async () => {
        if (registratore) return fine();
        if (!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder) {
          stato(s, 'Questo browser non permette di registrare.', 'stato--errore');
          return;
        }
        try {
          flusso = await navigator.mediaDevices.getUserMedia({ audio: true });
        } catch {
          stato(s, 'Microfono non autorizzato: consentilo nelle impostazioni del browser.', 'stato--errore');
          return;
        }
        speechSynthesis?.cancel();
        const pezzi: Blob[] = [];
        const tipo = tipoAudio();
        registratore = tipo ? new MediaRecorder(flusso, { mimeType: tipo }) : new MediaRecorder(flusso);
        registratore.ondataavailable = (e) => e.data.size && pezzi.push(e.data);
        registratore.onstop = async () => {
          clearInterval(timer);
          fermaDisegno();
          flusso?.getTracks().forEach((t) => t.stop());
          const blob = new Blob(pezzi, { type: registratore?.mimeType || tipo || 'audio/webm' });
          registratore = null;
          bottone.setAttribute('aria-pressed', 'false');
          bottone.classList.remove('rec--attivo');
          etichetta.textContent = 'Rifai la risposta';
          await invia(Number(s.dataset.ordine), blob);
        };

        // Forma d'onda dal vivo
        const ctx = new AudioContext();
        const analisi = ctx.createAnalyser();
        analisi.fftSize = 1024;
        ctx.createMediaStreamSource(flusso).connect(analisi);
        const dati = new Uint8Array(analisi.fftSize);
        const g = tela.getContext('2d')!;
        const colore = getComputedStyle(document.documentElement).getPropertyValue('--color-accent') || '#1f4e8c';
        let attivo = true;
        const disegna = () => {
          if (!attivo) return;
          analisi.getByteTimeDomainData(dati);
          g.clearRect(0, 0, tela.width, tela.height);
          g.lineWidth = 3;
          g.strokeStyle = colore;
          g.beginPath();
          for (let i = 0; i < dati.length; i++) {
            const x = (i / (dati.length - 1)) * tela.width;
            const y = (dati[i] / 255) * tela.height;
            i ? g.lineTo(x, y) : g.moveTo(x, y);
          }
          g.stroke();
          requestAnimationFrame(disegna);
        };
        fermaDisegno = () => {
          attivo = false;
          g.clearRect(0, 0, tela.width, tela.height);
          ctx.close();
        };
        disegna();

        const inizio = Date.now();
        timer = window.setInterval(() => {
          const sec = Math.floor((Date.now() - inizio) / 1000);
          durata.textContent = `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`;
          if (sec >= MAX_SECONDI) fine();
        }, 250);

        registratore.start(1000);
        bottone.setAttribute('aria-pressed', 'true');
        bottone.classList.add('rec--attivo');
        etichetta.textContent = 'Ho finito';
        stato(s, 'Ti ascolto… Massimo 3 minuti.');
      });
    });

    // ---------- Navigazione ----------
    const aggiornaRiepilogo = () => {
      const fatte = sezioni.filter((s) => s.dataset.fatta === '1').length;
      riepilogo.textContent = `${fatte} risposte su ${sezioni.length}.`;
    };
    const mostra = (i: number) => {
      attuale = Math.max(0, Math.min(sezioni.length, i));
      sezioni.forEach((s, j) => (s.hidden = j !== attuale));
      const fineEsame = attuale === sezioni.length;
      consegna.hidden = !fineEsame;
      avanti.hidden = fineEsame;
      indietro.disabled = attuale === 0;
      avanti.textContent = attuale === sezioni.length - 1 ? 'Termina' : 'Domanda successiva';
      progresso.textContent = fineEsame ? 'Consegna' : `Domanda ${attuale + 1} di ${sezioni.length}`;
      aggiornaRiepilogo();
      window.scrollTo({ top: 0 });
    };
    indietro.addEventListener('click', () => mostra(attuale - 1));
    avanti.addEventListener('click', () => mostra(attuale + 1));
    radice.classList.add('orale--js');
    mostra(Math.max(0, sezioni.findIndex((s) => s.dataset.fatta !== '1')));
    svuotaCoda();
  }
</script>

<style>
  .orale {
    display: grid;
    gap: var(--space-4);
    max-width: 48rem;
  }
  .barra-esame {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
    font-weight: var(--weight-semibold);
  }
  .barra-esame .muted {
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
  }
  .domanda {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    justify-items: start;
  }
  .domanda__testo {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.35;
  }
  .registratore {
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    background: var(--color-surface-muted);
    border-radius: var(--radius-lg);
  }
  .rec {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    cursor: pointer;
  }
  .rec__icona {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-danger);
    box-shadow: 0 0 0 4px var(--color-danger-soft);
    position: relative;
  }
  .rec__icona::after {
    content: '';
    position: absolute;
    inset: 22px;
    border-radius: 50%;
    background: var(--color-on-accent);
  }
  .rec--attivo .rec__icona::after {
    border-radius: 3px;
  }
  .rec--attivo .rec__icona {
    animation: pulsa 1.4s ease-in-out infinite;
  }
  @keyframes pulsa {
    50% {
      box-shadow: 0 0 0 10px var(--color-danger-soft);
    }
  }
  .onda {
    width: 100%;
    height: 56px;
  }
  .durata {
    font-weight: var(--weight-semibold);
    min-width: 3rem;
    text-align: right;
  }
  .stato:empty {
    display: none;
  }
  .stato {
    font-weight: var(--weight-medium);
    color: var(--color-accent);
  }
  .stato--errore {
    color: var(--color-danger);
  }
  .stato--attesa {
    color: var(--color-warning);
  }
  .trascrizione {
    width: 100%;
    display: grid;
    gap: var(--space-2);
  }
  .trascrizione h3 {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .testo {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-muted);
    border-radius: var(--radius-md);
    line-height: 1.55;
  }
  .metriche-box :global(.metriche) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .metriche-box :global(.metriche li) {
    padding: 2px var(--space-3);
    border: var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .comandi {
    display: none;
  }
  .orale--js .comandi {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .consegna {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    justify-items: start;
  }
  @media (max-width: 480px) {
    .registratore {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .durata {
      grid-column: 1 / -1;
      text-align: left;
    }
  }
</style>
