---
/** Metriche del parlato di una risposta orale, come etichette leggibili. */
import type { MetricheParlato } from '../lib/calcoli';

interface Props {
  metriche: MetricheParlato;
}
const { metriche: m } = Astro.props;
const virgola = (n: number) => String(n).replace('.', ',');
const parti = [
  m.paroleAlMinuto ? `${m.paroleAlMinuto} parole/min` : null,
  `${m.pauseLunghe} ${m.pauseLunghe === 1 ? 'pausa lunga' : 'pause lunghe'}`,
  `${m.intercalari} intercalari${m.intercalari ? ` (${Object.keys(m.intercalariUsati).join(', ')})` : ''}`,
  m.avvio !== null ? `avvio ${virgola(m.avvio)} s` : null,
  `${Math.round(m.durata)} s`,
].filter(Boolean);
---

<ul class="metriche" aria-label="Metriche del parlato">
  {parti.map((p) => <li>{p}</li>)}
</ul>

<style>
  .metriche {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  li {
    padding: 2px var(--space-3);
    border: var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
</style>
