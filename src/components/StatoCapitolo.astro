---
/**
 * Stato di padronanza di un capitolo: forma + parola + colore, mai il solo colore.
 * solido = quadrato pieno, in crescita = mezzo pieno, debole = triangolo d'avviso, mai provato = tratteggiato.
 */
import type { StatoPadronanza } from '../lib/calcoli';

interface Props {
  stato: StatoPadronanza;
  /** Senza riquadro, per la legenda. */
  breve?: boolean;
}
const { stato, breve = false } = Astro.props;
const ETICHETTE: Record<StatoPadronanza, string> = {
  solido: 'solido',
  'in-crescita': 'in crescita',
  debole: 'debole',
  'mai-provato': 'mai provato',
};
---

<span class:list={['stato', `stato--${stato}`, { 'stato--breve': breve }]}>
  <svg viewBox="0 0 12 12" aria-hidden="true">
    {stato === 'solido' && <rect x="1" y="1" width="10" height="10" rx="2" fill="currentColor" />}
    {stato === 'in-crescita' && (
      <>
        <rect x="1.5" y="1.5" width="9" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M1.5 6h9v3A1.5 1.5 0 0 1 9 10.5H3A1.5 1.5 0 0 1 1.5 9z" fill="currentColor" />
      </>
    )}
    {stato === 'debole' && (
      <>
        <path d="M6 1.2l5 9.3H1z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        <path d="M6 4.6v2.6M6 8.7v.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      </>
    )}
    {stato === 'mai-provato' && <rect x="1.5" y="1.5" width="9" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 1.6" />}
  </svg>
  {ETICHETTE[stato]}
</span>

<style>
  .stato {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  .stato svg {
    width: 12px;
    height: 12px;
    flex: none;
  }
  .stato--solido {
    color: var(--color-success);
  }
  .stato--in-crescita {
    color: var(--color-warning);
  }
  .stato--debole {
    color: var(--color-danger);
  }
  .stato--mai-provato {
    color: var(--color-ink-faint);
  }
</style>
