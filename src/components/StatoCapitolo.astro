---
/**
 * Stato di padronanza di un capitolo: forma + parola + colore, mai il solo colore.
 * Stesse forme dei seggi dell'emiciclo: solido = cerchio pieno, in crescita = mezzo, debole = quadrato, mai provato = anello.
 */
import type { StatoPadronanza } from '../lib/calcoli';

interface Props {
  stato: StatoPadronanza;
  /** Senza riquadro, per la legenda. */
  breve?: boolean;
}
const { stato, breve = false } = Astro.props;
const ETICHETTE: Record<StatoPadronanza, string> = {
  solido: 'solido',
  'in-crescita': 'in crescita',
  debole: 'debole',
  'mai-provato': 'mai provato',
};
---

<span class:list={['stato', `stato--${stato}`, { 'stato--breve': breve }]}>
  <svg viewBox="0 0 12 12" aria-hidden="true">
    {stato === 'solido' && <circle cx="6" cy="6" r="5" class="pieno" />}
    {stato === 'in-crescita' && (
      <>
        <circle cx="6" cy="6" r="4.4" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M6 1.6a4.4 4.4 0 0 1 0 8.8z" class="pieno" />
      </>
    )}
    {stato === 'debole' && <rect x="1.5" y="1.5" width="9" height="9" rx="1.2" class="pieno" />}
    {stato === 'mai-provato' && <circle cx="6" cy="6" r="4.4" fill="none" stroke="currentColor" stroke-width="1.4" />}
  </svg>
  {ETICHETTE[stato]}
</span>

<style>
  .stato {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }
  .stato svg {
    width: 12px;
    height: 12px;
    flex: none;
  }
  .pieno {
    fill: currentColor;
  }
  .stato--solido {
    color: var(--color-success);
  }
  .stato--in-crescita {
    color: var(--color-warning);
  }
  .stato--debole {
    color: var(--color-danger);
  }
  .stato--mai-provato {
    color: var(--color-ink-faint);
  }
</style>
