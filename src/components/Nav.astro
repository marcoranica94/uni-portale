---
/**
 * Navigazione principale: barra laterale su schermi larghi, barra in basso su telefono.
 * Quattro voci fisse; la voce attiva è marcata con aria-current, colore e peso.
 */
const voci = [
  { href: '/', label: 'Oggi', icon: 'oggi' },
  { href: '/percorso', label: 'Percorso', icon: 'percorso' },
  { href: '/materie', label: 'Materie', icon: 'materie' },
  { href: '/libretto', label: 'Libretto', icon: 'libretto' },
] as const;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<nav class="nav" aria-label="Navigazione principale">
  <a class="nav__brand" href="/">
    <span class="nav__mark" aria-hidden="true">U</span>
    <span class="nav__name">Uni</span>
  </a>
  <ul class="nav__list">
    {voci.map((v) => (
      <li>
        <a class="nav__item" href={v.href} aria-current={isActive(v.href) ? 'page' : undefined}>
          <svg class="nav__icon" viewBox="0 0 24 24" aria-hidden="true">
            {v.icon === 'oggi' && (
              <>
                <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" />
                <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </>
            )}
            {v.icon === 'percorso' && (
              <>
                <circle cx="5" cy="18" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8" />
                <circle cx="19" cy="6" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8" />
                <path d="M7 17c5 0 3-5 6-6.5S17 9 17.5 7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-dasharray="2.5 2.5" />
              </>
            )}
            {v.icon === 'materie' && (
              <>
                <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                <path d="M13 4h5.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H13z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              </>
            )}
            {v.icon === 'libretto' && (
              <>
                <rect x="5" y="3" width="14" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
                <path d="M8.5 8h7M8.5 12h7M8.5 16h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </>
            )}
          </svg>
          <span class="nav__label">{v.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* Telefono: barra fissa in basso */
  .nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    background: var(--color-surface);
    border-top: var(--border);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    padding-left: env(safe-area-inset-left, 0px);
    padding-right: env(safe-area-inset-right, 0px);
  }
  .nav__brand {
    display: none;
  }
  .nav__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: var(--nav-bottom-height);
    min-width: var(--tap-min);
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }
  .nav__icon {
    width: 24px;
    height: 24px;
  }
  .nav__item:hover {
    color: var(--color-ink);
  }
  .nav__item[aria-current='page'] {
    color: var(--color-accent);
    font-weight: var(--weight-bold);
  }

  /* Schermi larghi: barra laterale */
  @media (min-width: 900px) {
    .nav {
      inset: 0 auto 0 0;
      width: var(--nav-width);
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      padding: var(--space-5) var(--space-3);
      padding-left: max(var(--space-3), env(safe-area-inset-left, 0px));
      border-top: none;
      border-right: var(--border);
    }
    .nav__brand {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: 0 var(--space-3);
      color: var(--color-ink);
      text-decoration: none;
    }
    .nav__mark {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border-radius: var(--radius-md);
      background: var(--color-accent);
      color: var(--color-on-accent);
      font-family: var(--font-serif);
      font-weight: var(--weight-bold);
    }
    .nav__name {
      font-family: var(--font-serif);
      font-size: var(--text-xl);
      font-weight: var(--weight-semibold);
    }
    .nav__list {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .nav__item {
      flex-direction: row;
      justify-content: flex-start;
      gap: var(--space-3);
      min-height: var(--tap-min);
      padding: 0 var(--space-3);
      border-radius: var(--radius-md);
      font-size: var(--text-base);
    }
    .nav__item[aria-current='page'] {
      background: var(--color-accent-soft);
    }
  }
</style>
