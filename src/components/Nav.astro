---
/**
 * Navigazione principale: barra in basso su telefono e tablet, barra superiore da 800 px.
 * Cinque voci fisse; la voce attiva è marcata con aria-current, colore, peso e fondo.
 */
const voci = [
  { href: '/', label: 'Oggi', icon: 'oggi' },
  { href: '/materie', label: 'Materie', icon: 'materie' },
  { href: '/percorso', label: 'Percorso', icon: 'percorso' },
  { href: '/libretto', label: 'Libretto', icon: 'libretto' },
  { href: '/cerca', label: 'Cerca', icon: 'cerca' },
] as const;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<nav class="nav" aria-label="Navigazione principale">
  <a class="nav__brand" href="/">
    <svg class="nav__marchio" viewBox="0 0 32 22" aria-hidden="true"><path d="M2 20a14 14 0 0 1 28 0M7 20a9 9 0 0 1 18 0M12 20a4 4 0 0 1 8 0" fill="none" stroke="currentColor" stroke-width="2.6" stroke-dasharray="1 4" stroke-linecap="round" /></svg>
    <span class="nav__name">Uni</span>
  </a>
  <ul class="nav__list">
    {voci.map((v) => (
      <li>
        <a class="nav__item" data-search={v.icon === 'cerca' ? '' : undefined} href={v.href} aria-current={isActive(v.href) ? 'page' : undefined}>
          <svg class="nav__icon" viewBox="0 0 24 24" aria-hidden="true">
            {v.icon === 'oggi' && (
              <>
                <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </>
            )}
            {v.icon === 'percorso' && (
              <>
                <circle cx="5" cy="18" r="2.2" fill="none" stroke="currentColor" stroke-width="1.6" />
                <circle cx="19" cy="6" r="2.2" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M7 17c5 0 3-5 6-6.5S17 9 17.5 7.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="2.5 2.5" />
              </>
            )}
            {v.icon === 'materie' && (
              <>
                <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                <path d="M13 4h5.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H13z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
              </>
            )}
            {v.icon === 'cerca' && (
              <>
                <circle cx="10.5" cy="10.5" r="6" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M15 15l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </>
            )}
            {v.icon === 'libretto' && (
              <>
                <rect x="5" y="3" width="14" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M8.5 8h7M8.5 12h7M8.5 16h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </>
            )}
          </svg>
          <span class="nav__label">{v.label}</span>
        </a>
      </li>
    ))}
  </ul>
  <button class="nav__tema" type="button" aria-label="Attiva tema scuro" aria-pressed="false" data-tema-rapido>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.4A8.5 8.5 0 0 1 8.6 4a8.5 8.5 0 1 0 11.4 11.4Z" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
  </button>
</nav>

<script>
  const bottone = document.querySelector<HTMLButtonElement>('[data-tema-rapido]')!;
  const sistema = matchMedia('(prefers-color-scheme: dark)');
  const scuro = () => document.documentElement.dataset.theme ? document.documentElement.dataset.theme === 'dark' : sistema.matches;
  const aggiorna = () => {
    bottone.setAttribute('aria-pressed', String(scuro()));
    bottone.setAttribute('aria-label', `Attiva tema ${scuro() ? 'chiaro' : 'scuro'}`);
  };
  bottone.addEventListener('click', () => {
    const tema = scuro() ? 'light' : 'dark';
    document.documentElement.dataset.theme = tema;
    try { localStorage.setItem('tema', tema); } catch {}
    document.dispatchEvent(new Event('uni:theme'));
  });
  document.addEventListener('uni:theme', aggiorna);
  sistema.addEventListener('change', aggiorna);
  aggiorna();
</script>

<style>
  .nav { position: fixed; inset: auto 0 0; z-index: 20; background: var(--color-nav); border-top: var(--border); padding-bottom: env(safe-area-inset-bottom, 0px); padding-inline: env(safe-area-inset-left, 0px) env(safe-area-inset-right, 0px); }
  .nav__brand, .nav__tema { display: none; }
  .nav__list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  .nav__item { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; min-height: var(--nav-bottom-height); color: var(--color-ink-faint); font-size: var(--text-xs); font-weight: var(--weight-medium); text-decoration: none; }
  .nav__item::after { content: ''; width: 4px; height: 4px; border-radius: 50%; background: transparent; }
  .nav__icon { width: 22px; height: 22px; }
  .nav__label { max-width: 100%; overflow-wrap: anywhere; text-align: center; }
  .nav__item:hover { color: var(--color-ink); }
  .nav__item[aria-current='page'] { color: var(--color-accent); }
  .nav__item[aria-current='page']::after { background: currentColor; }
  @media (min-width: 800px) {
    .nav { position: sticky; top: 0; bottom: auto; display: flex; align-items: center; gap: 48px; min-height: var(--nav-top-height); padding: 0 max(40px, calc((100vw - var(--content-max)) / 2 + 40px)); border-top: 0; border-bottom: var(--border); }
    .nav__brand { display: inline-flex; align-items: center; gap: 10px; flex: none; color: var(--color-accent); text-decoration: none; }
    .nav__name { font-size: 1.7rem; font-weight: 700; line-height: 1; }
    .nav__marchio { width: 32px; height: 25px; }
    .nav__list { display: flex; align-self: stretch; flex: 1; gap: 30px; }
    .nav__list li { display: flex; }
    .nav__list li:last-child { margin-left: auto; }
    .nav__item { flex-direction: row; gap: 8px; min-height: var(--nav-top-height); font-size: var(--text-base); }
    .nav__icon { display: none; }
    .nav__list li:last-child .nav__icon { display: block; width: 18px; height: 18px; }
    .nav__item::after { position: absolute; inset: auto 0 0; width: auto; height: 3px; border-radius: 2px 2px 0 0; }
    .nav__tema { display: grid; place-items: center; flex: none; width: 44px; height: 44px; padding: 0; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--color-ink); cursor: pointer; }
    .nav__tema svg { width: 22px; height: 22px; }
    .nav__tema:hover { background: var(--color-surface-muted); }
  }
  @media (min-width: 800px) and (max-width: 1000px) { .nav { gap: 26px; padding-inline: 32px; } .nav__list { gap: 22px; } }
</style>
