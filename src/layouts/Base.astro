---
import '@fontsource/titillium-web/latin-400.css';
import '@fontsource/titillium-web/latin-600.css';
import '@fontsource/titillium-web/latin-700.css';
import '@fontsource/titillium-web/latin-900.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import SceltaTema from '../components/SceltaTema.astro';
import Promemoria from '../components/Promemoria.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portale di studio personale - Scienze politiche e strategie globali, UniBg.' } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f3f5f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1a15" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- App sulla schermata Home (serve anche alle notifiche su iPhone). Il manifest passa da Cloudflare Access: va chiesto con i cookie. -->
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="apple-touch-icon" href="/icone/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Uni" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{title === 'Uni' ? 'Uni' : `${title} · Uni`}</title>
    <script is:inline>
      // Applica il tema scelto prima del primo disegno, per evitare lampi.
      try {
        var t = localStorage.getItem('tema');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <Nav />
    <main class="page">
      <slot />
      <footer class="piede">
        <Promemoria />
        <SceltaTema />
      </footer>
    </main>
    <script>
      // Service worker: solo per le notifiche (nessuna cache delle pagine).
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
    </script>
    <script>
      // Scorciatoia globale: "/" apre la ricerca negli appunti (spenta mentre scrivi in un campo).
      document.addEventListener('keydown', (e) => {
        if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target as HTMLElement | null;
        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        const campo = document.getElementById('q');
        e.preventDefault();
        if (campo) campo.focus();
        else location.href = '/cerca';
      });
    </script>
  </body>
</html>

<style>
  .page {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding-block: var(--space-5) calc(var(--nav-bottom-height) + var(--space-6) + env(safe-area-inset-bottom, 0px));
    padding-left: max(var(--space-4), env(safe-area-inset-left, 0px));
    padding-right: max(var(--space-4), env(safe-area-inset-right, 0px));
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }
  .piede {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-5);
    border-top: var(--border);
  }
  /* Da 1024 px: barra laterale fissa, contenuto centrato nello spazio a destra */
  @media (min-width: 1024px) {
    body {
      padding-left: var(--nav-width);
    }
    .page {
      padding: var(--space-6) var(--space-6) var(--space-7);
      gap: var(--space-7);
    }
  }
</style>
